<UserControl x:Class="Lib.Ui.Screens.Views.ModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{StaticResource TextBrushMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Row="0"
                       Text="Mode"
                       FontSize="28"
                       FontWeight="Bold"/>

            <!-- 説明 -->
            <TextBlock Grid.Row="2"
                       Text="演出モードを選択：以降の演出コマンド時の既定挙動になります。"
                       FontSize="13"
                       Opacity="0.85"/>

            <!-- モード一覧 -->
            <ItemsControl Grid.Row="4"
                          ItemsSource="{Binding Modes}"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectModeCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GrandMaSelectableButtonStyle}"
                                Tag="{Binding IsSelected}"
                                FocusVisualStyle="{x:Null}"
                                Width="380"
                                Height="130"
                                Margin="8"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 左端のアクセント色バー -->
                                <Rectangle Grid.Column="0"
                                           Fill="{Binding AccentBrush}"
                                           Width="6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Margin="0,14,0,14"
                                           RadiusX="3"
                                           RadiusY="3"/>
                                <Grid Grid.Column="1"
                                      Margin="10,18,14,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- タイトル行：常にタイル上部 18px 位置 -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- 説明行：MaxHeight + TextTrimming で最大2行＋省略 -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               Opacity="0.85"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 選択中モード詳細 + 適用ボタン -->
            <Border Grid.Row="6"
                    BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="選択中モード / Selected Mode"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedModeDetail}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
				            Content="適用 / Apply"
				            Command="{Binding ApplyModeCommand}"
				            IsEnabled="{Binding HasSelection}"
				            Style="{StaticResource GrandMaButtonStyle}"
				            MinWidth="180"
				            MinHeight="48"
				            VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>