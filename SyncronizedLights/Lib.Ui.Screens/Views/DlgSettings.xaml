<Window x:Class="Lib.Ui.Screens.Views.DlgSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lib.Ui.Screens.Views"
        Title="接続設定"
        SizeToContent="Height"
        Width="900"
        MaxHeight="1800"
        MinWidth="500"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SettingView を内包 -->
        <views:SettingView x:Name="SettingContent" Grid.Row="0"/>

        <!-- 閉じるボタン -->
        <Border Grid.Row="1"
                Background="#1A1A1A"
                Padding="10">
            <!-- 送信機初期化(FA/FB)中は「閉じる」を無効化（完了までオペレータを待たせる） -->
            <Button Content="閉じる"
                    Click="BtnClose_Click"
                    IsEnabled="{Binding DataContext.CanClose, ElementName=SettingContent, FallbackValue=True, TargetNullValue=True}"
                    Style="{StaticResource GrandMaButtonStyle}"
                    HorizontalAlignment="Right"
                    MinWidth="120"
                    MinHeight="36"/>
        </Border>
    </Grid>
</Window>
