<UserControl x:Class="Lib.Ui.Screens.Views.AnimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{StaticResource TextBrushMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Row="0"
                       Text="Animation"
                       FontSize="28"
                       FontWeight="Bold"/>

            <!-- 説明 -->
            <TextBlock Grid.Row="2"
                       Text="Animation パターン一覧：タイルをタップして選択し、「実行」で送信します。"
                       FontSize="13"
                       Opacity="0.85"/>

            <!-- アニメーション一覧 -->
            <ItemsControl Grid.Row="4"
                          ItemsSource="{Binding Animations}"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectAnimationCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Tag="{Binding IsSelected}"
                                FocusVisualStyle="{x:Null}"
                                Width="170"
                                Height="110"
                                Margin="6"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GrandMaSelectableButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefined}" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <!-- 内部コンテンツ：アイコン（上）+ タイル名（下） -->
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- アイコン（色付き角丸四角、IconBrush でバインド） -->
                                <Rectangle Grid.Row="0"
                                           Width="44"
                                           Height="44"
                                           RadiusX="10"
                                           RadiusY="10"
                                           Fill="{Binding IconBrush}"
                                           Stroke="White"
                                           StrokeThickness="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- タイル名（Name でバインド、例：Animation 01） -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- プレビュー + 実行ボタン -->
            <Border Grid.Row="6"
                    BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,10"
                    MinHeight="180">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- プレビュー光可視化 -->
                    <Grid Grid.Column="0"
                          Width="160" Height="160"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                        <Ellipse Width="160" Height="160"
                                 Fill="#0A0A0A"
                                 Stroke="{StaticResource BorderBrushAmber}"
                                 StrokeThickness="1"/>
                        <Ellipse Width="{Binding PreviewLightSize}"
                                 Height="{Binding PreviewLightSize}"
                                 Fill="{Binding PreviewLightBrush}"
                                 Opacity="{Binding PreviewLightOpacity}">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <!-- 説明テキスト -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <TextBlock Text="プレビュー / Preview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- 実行ボタン -->
                    <Button Grid.Column="2"
                            Content="実行 / Execute"
                            Command="{Binding ExecuteAnimationCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinWidth="200"
                            MinHeight="48"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>