<Window x:Class="Lib.Ui.Screens.Views.DlgSequence"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="シーケンス実行 | Sequence Execute"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock x:Name="TitleLabel"
                   Grid.Row="0"
                   Text="シーケンス実行"
                   FontSize="20"
                   FontWeight="Bold"/>

        <!-- 開始番号 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="開始番号 / Start"
                       VerticalAlignment="Center"
                       FontSize="14"/>
            <TextBox x:Name="TxtStart"
		             Grid.Column="1"
		             Style="{StaticResource GrandMaTextBoxStyle}"
		             Text="1"
		             TextChanged="Input_TextChanged"/>
        </Grid>

        <!-- 終了番号 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="終了番号 / End"
                       VerticalAlignment="Center"
                       FontSize="14"/>
            <TextBox x:Name="TxtEnd"
		             Grid.Column="1"
		             Style="{StaticResource GrandMaTextBoxStyle}"
		             Text="100"
		             TextChanged="Input_TextChanged"/>
        </Grid>

        <!-- 遅延時間 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="遅延時間 / Delay (ms)"
                       VerticalAlignment="Center"
                       FontSize="14"/>
            <TextBox x:Name="TxtDelay"
		             Grid.Column="1"
		             Style="{StaticResource GrandMaTextBoxStyle}"
		             Text="100"
		             TextChanged="Input_TextChanged"/>
        </Grid>

        <!-- 色選択（任意） -->
        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="色（任意） / Color"
                       VerticalAlignment="Center"
                       FontSize="14"/>
            <CheckBox x:Name="ChkUseColor"
		              Grid.Column="1"
		              Content="使用"
		              Style="{StaticResource GrandMaCheckBoxStyle}"
		              VerticalAlignment="Center"
		              Margin="0,0,12,0"/>
            <Rectangle x:Name="ColorPreview"
                       Grid.Column="2"
                       Height="30"
                       Fill="White"
                       Stroke="{StaticResource TextBrushMain}"
                       StrokeThickness="1"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnPickColor"
		            Grid.Column="3"
		            Content="選択..."
		            Style="{StaticResource GrandMaButtonStyle}"
		            MinWidth="80"
		            MinHeight="30"
		            Margin="10,0,0,0"
		            Click="BtnPickColor_Click"/>
        </Grid>

        <!-- バリデーションメッセージ -->
        <TextBlock x:Name="TxtValidationMessage"
                   Grid.Row="9"
                   Text=""
                   Foreground="#FF6B6B"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="BtnOK"
		            Content="OK / 実行"
		            Style="{StaticResource GrandMaButtonStyle}"
		            Width="110"
		            Height="36"
		            Click="BtnOK_Click"
		            Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel"
		            Content="Cancel"
		            Style="{StaticResource GrandMaButtonStyle}"
		            Width="90"
		            Height="36"
		            Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>