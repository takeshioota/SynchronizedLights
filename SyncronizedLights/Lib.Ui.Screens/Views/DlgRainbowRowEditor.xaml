<Window x:Class="Lib.Ui.Screens.Views.DlgRainbowRowEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rainbow 設定（この行）"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0" Text="この行のレインボー色・モードを編集します（色は 2〜7 色まで、行ごとに設定できます）"
                   TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#CCC"/>

        <!-- カラーパレット -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="色（右クリックで編集／削除）" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <WrapPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding RainbowColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="32" Height="32" Margin="0,0,4,4" BorderThickness="1" BorderBrush="#555"
                                    CornerRadius="4" Cursor="Hand"
                                    Background="{Binding HexColor}"
                                    ToolTip="{Binding HexColor}"
                                    MouseLeftButtonDown="Swatch_MouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="色を編集..." Click="RainbowColorEdit_Click"/>
                                        <MenuItem Header="削除" Click="RainbowColorDelete_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋追加" Click="AddColor_Click"
                        Style="{StaticResource GrandMaButtonStyle}" MinHeight="32" Width="64" Margin="4,0,0,4"
                        FontWeight="Bold" ToolTip="色を追加（最大7色）"/>
            </WrapPanel>
        </StackPanel>

        <!-- モード -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="モード:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox Width="150" MinHeight="28"
                      SelectedIndex="{Binding RainbowModeIndex, Mode=TwoWay}">
                <ComboBoxItem Content="常時点灯 (Solid)"/>
                <ComboBoxItem Content="点滅 (Blink)"/>
                <ComboBoxItem Content="FI / FO"/>
                <ComboBoxItem Content="Fade In"/>
                <ComboBoxItem Content="Fade Out"/>
                <ComboBoxItem Content="ランダム"/>
            </ComboBox>
            <TextBlock Text="速度(ms):" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Width="70" Text="{Binding RainbowCycleDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource GrandMaTextBoxStyle}" HorizontalContentAlignment="Right"
                     Padding="6,2" MinHeight="28" ToolTip="色切り替え速度（500〜2500ms）"/>
        </WrapPanel>

        <!-- モード別パラメータ -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="点滅周期(ms):" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="60" Text="{Binding RainbowBlinkPeriodMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource GrandMaTextBoxStyle}" HorizontalContentAlignment="Right"
                     Padding="6,2" MinHeight="28" ToolTip="Blink モード: 点滅周期（100〜3600ms）"/>
            <TextBlock Text="比率:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Width="40" Text="{Binding RainbowDutyRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource GrandMaTextBoxStyle}" HorizontalContentAlignment="Right"
                     Padding="6,2" MinHeight="28" ToolTip="Blink モード: 点灯比率（1-9 = 10%-90%）"/>
            <TextBlock Text="FI(ms):" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Width="60" Text="{Binding RainbowFadeInMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource GrandMaTextBoxStyle}" HorizontalContentAlignment="Right"
                     Padding="6,2" MinHeight="28" ToolTip="フェードイン時間（256〜3000ms）"/>
            <TextBlock Text="FO(ms):" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox Width="60" Text="{Binding RainbowFadeOutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource GrandMaTextBoxStyle}" HorizontalContentAlignment="Right"
                     Padding="6,2" MinHeight="28" ToolTip="フェードアウト時間（256〜3000ms）"/>
        </WrapPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource GrandMaButtonStyle}" MinHeight="32" Width="100"
                    Foreground="#4CAF50" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
