<Window x:Class="Lib.Ui.Screens.Views.DlgColorPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="色を選択 | Color Picker"
        Width="950"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="256"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PckSV: 彩度×明度 ピッカー -->
        <Canvas x:Name="PckSV"
                Grid.Row="0"
                Grid.Column="0"
                Width="256"
                Height="256"
                Cursor="Cross"
                MouseLeftButtonDown="PckSV_MouseLeftButtonDown"
                MouseMove="PckSV_MouseMove"
                MouseLeftButtonUp="PckSV_MouseLeftButtonUp">
            <!-- 基本色（色相に応じてコードから設定） -->
            <Rectangle x:Name="SVBase" Width="256" Height="256"/>
            <!-- 白→透明の水平オーバーレイ -->
            <Rectangle Width="256" Height="256" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 透明→黒の垂直オーバーレイ -->
            <Rectangle Width="256" Height="256" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#FF000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 選択位置マーカー -->
            <Ellipse x:Name="SVThumb"
                     Width="14" Height="14"
                     Stroke="White"
                     StrokeThickness="2"
                     IsHitTestVisible="False"
                     Canvas.Left="242"
                     Canvas.Top="-6"/>
        </Canvas>

        <!-- SldHue: 色相バー -->
        <Grid Grid.Row="0" Grid.Column="2" Width="30" Height="256">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0"     Color="#FF0000"/>
                        <GradientStop Offset="0.167" Color="#FFFF00"/>
                        <GradientStop Offset="0.333" Color="#00FF00"/>
                        <GradientStop Offset="0.5"   Color="#00FFFF"/>
                        <GradientStop Offset="0.667" Color="#0000FF"/>
                        <GradientStop Offset="0.833" Color="#FF00FF"/>
                        <GradientStop Offset="1"     Color="#FF0000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas x:Name="SldHue"
                    Background="Transparent"
                    Cursor="SizeNS"
                    MouseLeftButtonDown="SldHue_MouseLeftButtonDown"
                    MouseMove="SldHue_MouseMove"
                    MouseLeftButtonUp="SldHue_MouseLeftButtonUp">
                <Rectangle x:Name="HueThumb"
                           Width="34"
                           Height="4"
                           Fill="White"
                           Stroke="Black"
                           StrokeThickness="1"
                           IsHitTestVisible="False"
                           Canvas.Left="-2"
                           Canvas.Top="-2"/>
            </Canvas>
        </Grid>

        <!-- 右パネル：プレビューとRGB表示 + RGBスライダー -->
        <StackPanel Grid.Row="0" Grid.Column="4">
            <TextBlock Text="Preview / プレビュー"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>
            <Rectangle x:Name="ColorPreview"
                       Width="220"
                       Height="60"
                       Stroke="{StaticResource TextBrushMain}"
                       StrokeThickness="1"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtRgb"
                       Text="R: 255  G: 255  B: 255"
                       FontSize="13"
                       Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtHex"
                       Text="#FFFFFF"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <!-- v3.9: RGBスライダー -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#FF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SldR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        ValueChanged="SldRgb_ValueChanged"/>
                <TextBox x:Name="TxtR" Grid.Row="0" Grid.Column="2" Width="60" Margin="4,0,0,0"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Style="{StaticResource GrandMaTextBoxStyle}" TextChanged="TxtRgb_TextChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SldG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        ValueChanged="SldRgb_ValueChanged"/>
                <TextBox x:Name="TxtG" Grid.Row="1" Grid.Column="2" Width="60" Margin="4,0,0,0"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Style="{StaticResource GrandMaTextBoxStyle}" TextChanged="TxtRgb_TextChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#2196F3" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SldB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255"
                        SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        ValueChanged="SldRgb_ValueChanged"/>
                <TextBox x:Name="TxtB" Grid.Row="2" Grid.Column="2" Width="60" Margin="4,0,0,0"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Style="{StaticResource GrandMaTextBoxStyle}" TextChanged="TxtRgb_TextChanged"/>
            </Grid>
        </StackPanel>

        <!-- よく使う色（スウォッチ） -->
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="5"
                   Text="よく使う色 / Swatches"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <UniformGrid x:Name="LstSwatches"
                     Grid.Row="3"
                     Grid.ColumnSpan="5"
                     Rows="1"
                     Columns="10"
                     Height="32"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Width="420"/>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="BtnOK"
                    Content="OK"
                    Style="{StaticResource GrandMaButtonStyle}"
                    Width="90"
                    Height="34"
                    Click="BtnOK_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Style="{StaticResource GrandMaButtonStyle}"
                    Width="90"
                    Height="34"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>