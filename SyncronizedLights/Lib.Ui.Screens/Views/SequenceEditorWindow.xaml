<Window x:Class="Lib.Ui.Screens.Views.SequenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:conv="clr-namespace:Lib.Ui.Screens.Converters"
        mc:Ignorable="d"
        Title="シーケンス編集"
        Width="1150"
        Height="2000"
        MinWidth="900"
        MinHeight="1000"
        ResizeMode="CanResize"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}"
        PreviewKeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <x:Array x:Key="CommandOptions" Type="sys:String">
            <sys:String>SetColor</sys:String>
            <sys:String>FadeIn</sys:String>
            <sys:String>FadeOut</sys:String>
            <sys:String>Flash</sys:String>
            <sys:String>Breath</sys:String>
            <sys:String>Off</sys:String>
            <sys:String>SevenColor</sys:String>
        </x:Array>

        <x:Array x:Key="CommandTypeOptions" Type="sys:String">
            <sys:String>Color</sys:String>
            <!-- NO.35: Color2（2色交互点灯）はボタン・コマンドとも廃止 -->
            <sys:String>Off</sys:String>
            <sys:String>Effect</sys:String>
            <sys:String>EffectStop</sys:String>
            <sys:String>Rainbow</sys:String>
            <sys:String>RainbowStop</sys:String>
            <sys:String>RainbowPause</sys:String>
            <sys:String>SignalOff</sys:String>
            <sys:String>Preset</sys:String>
            <sys:String>InternalProgram</sys:String>
        </x:Array>

        <!-- DataGrid のエフェクト種別ドロップダウン候補。
             「FadeIn/In」「FadeOut/Out」は内部的には FadeIn / FadeOut に
             連続実行フラグ false を組み合わせた値で、表示・選択時に区別できるよう
             ドロップダウンの選択肢として含めている。 -->
        <x:Array x:Key="EffectTypeOptions" Type="sys:String">
            <x:Static Member="sys:String.Empty"/>
            <sys:String>Flash</sys:String>
            <sys:String>FadeIn</sys:String>
            <sys:String>FadeIn/In</sys:String>
            <sys:String>FadeOut</sys:String>
            <sys:String>FadeOut/Out</sys:String>
            <sys:String>Breathing</sys:String>
            <sys:String>SevenColor</sys:String>
        </x:Array>

        <Style x:Key="GrandMaDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                                <Path x:Name="SortArrow" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,6,0" Fill="#111111"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 6 L 4 0 L 8 6 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 6 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GrandMaDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                    <Setter Property="Foreground" Value="#111111"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GrandMaDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#1F1F1F"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A2E00"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                    <!-- NO.41: 選択行(黄背景)の文字を黒系に統一し視認性を確保（白文字対策） -->
                    <Setter Property="Foreground" Value="#111111"/>
                </Trigger>
                <!-- 連続再生中の現在ステップを強調表示（緑色 + 太枠） -->
                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                    <Setter Property="BorderBrush" Value="#7CFF7C"/>
                    <Setter Property="BorderThickness" Value="0,2,0,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GrandMaDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GrandMaDataGridColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource GrandMaDataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource GrandMaDataGridRowStyle}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <!-- 左ペイン：シーケンス一覧 -->
            <ColumnDefinition Width="240"/>
            <!-- スプリッタ -->
            <ColumnDefinition Width="6"/>
            <!-- 右ペイン：エディタ -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左ペイン：シーケンス一覧 ============ -->
        <Border Grid.Column="0"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 一覧タイトル -->
                    <RowDefinition Height="Auto"/>
                    <!-- 記録開始ボタン -->
                    <RowDefinition Height="Auto"/>
                    <!-- 更新ボタン -->
                    <RowDefinition Height="Auto"/>
                    <!-- ListBox（一覧本体）-->
                    <RowDefinition Height="*"/>
                    <!-- 新規 / 削除 -->
                    <RowDefinition Height="Auto"/>
                    <!-- F7: 一括再生 / API同期 -->
                    <RowDefinition Height="Auto"/>
                    <!-- F6: 接続設定ボタン -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="シーケンス一覧"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{StaticResource AccentAmberBrush}"
                           Margin="0,0,0,6"/>

                <!-- 記録開始（押下中は「■ 記録停止」表記）-->
                <Button Grid.Row="1"
                        Content="{Binding RecordButtonText}"
                        Command="{Binding ToggleRecordingCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsRecording}"
                        MinHeight="36"
                        FontWeight="Bold"
                        Foreground="#FF5252"
                        Margin="0,0,0,6"
                        ToolTip="操作を新規シーケンスとして記録します"/>

                <Button Grid.Row="2"
                        Content="更新"
                        Command="{Binding RefreshListCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinHeight="30"
                        Margin="0,0,0,6"
                        ToolTip="保存ディレクトリから一覧を再読込"/>

                <ListBox x:Name="SequenceListBox"
                         Grid.Row="3"
                         ItemsSource="{Binding Sequences}"
                         SelectedItem="{Binding SelectedSequence, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         Background="#0F0F0F"
                         Foreground="#F2F2F2"
                         BorderBrush="{StaticResource AccentAmberBrush}"
                         BorderThickness="1"
                         Margin="0,0,0,6"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="新規"
                            Command="{Binding NewSequenceCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="30"
                            Margin="0,0,2,0"/>
                    <Button Grid.Column="1"
                            Content="削除"
                            Command="{Binding DeleteSequenceCommand}"
                            IsEnabled="{Binding HasSelectedSequence}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="30"
                            Margin="2,0,0,0"/>
                </Grid>

                <!-- F7: 一括再生 / API 同期（デフォルト折りたたみ） -->
                <Expander Grid.Row="5"
                          Header="一括再生 / API 同期"
                          IsExpanded="False"
                          Foreground="#F2F2F2"
                          Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding PlayButtonText}"
                                Command="{Binding PlayOrStopCommand}"
                                IsEnabled="{Binding IsApiEnabled}"
                                Style="{StaticResource GrandMaSelectableButtonStyle}"
                                Tag="{Binding IsPlaying}"
                                MinHeight="34" Width="120"
                                Margin="0,0,6,0"
                                ToolTip="現在のシーケンスを API 経由で再生 / 停止します"/>
                        <Button Content="API 同期"
                                Command="{Binding SyncToApiCommand}"
                                IsEnabled="{Binding IsApiEnabled}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="110"
                                ToolTip="編集中の内容を API サーバーへ Upsert（再生せず登録のみ）"/>
                    </StackPanel>
                </Expander>

                <!-- F6: 接続設定ボタン（メイン画面を経由せずに設定・イニシャライズ可能） -->
                <Button Grid.Row="6"
                        Content="接続設定 / Initialize"
                        Command="{Binding ShowSettingsDialogCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinHeight="34"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"
                        ToolTip="接続設定・送信機イニシャライズをポップアップで表示"/>
            </Grid>
        </Border>

        <!-- ============ スプリッタ ============ -->
        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#2A2A2A"
                      Width="6"/>

        <!-- ============ 右ペイン：エディタ ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- 0: 名前 + 保存ボタン -->
                <RowDefinition Height="Auto"/>
                <!-- 1: ステップ表示 -->
                <RowDefinition Height="Auto"/>
                <!-- 2: DataGrid -->
                <RowDefinition Height="*"/>
                <!-- 3: プリセット -->
                <RowDefinition Height="Auto"/>
                <!-- 4: 送信ログ -->
                <RowDefinition Height="Auto"/>
                <!-- 5: ステータスバー -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ============ 名前 + 保存 ============ -->
        <Border Grid.Row="0"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="8,4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="名前："
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBox Width="280"
                         Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasSelectedSequence}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Padding="6,2"
                         MinHeight="30"
                         Margin="0,0,12,0"
                         ToolTip="シーケンス名を編集して「保存」を押すと名称が変更されます">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource GrandMaTextBoxStyle}">
                            <Style.Triggers>
                                <!-- 名前重複時は赤枠で警告 -->
                                <DataTrigger Binding="{Binding IsNameDuplicate}" Value="True">
                                    <Setter Property="BorderBrush" Value="#DC3545"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Separator Width="1" Background="#444" Margin="0,4,12,4"/>

                <Button Content="編集破棄"
                        Command="{Binding DiscardChangesCommand}"
                        IsEnabled="{Binding HasSelectedSequence}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinHeight="30" Width="80"
                        Margin="0,0,4,0"/>
                <Button Content="保存"
                        Command="{Binding SaveSequenceCommand}"
                        IsEnabled="{Binding HasSelectedSequence}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinHeight="30" Width="70"/>

                <!-- 名前エラーメッセージ（重複時のみ表示）-->
                <TextBlock Text="{Binding NameErrorMessage}"
                           Foreground="#FF6B6B"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNameDuplicate}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ ステップ表示 + 操作キーガイド + 停止ボタン ============ -->
        <Border Grid.Row="1"
                Background="#0F0F0F"
                BorderBrush="{StaticResource AccentAmberBrush}"
                BorderThickness="1,1,1,0"
                Padding="8,3" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentStepLabel}"
                           Foreground="#FFC107"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <!-- NO.23: Emergency White 削除（Black のみ） -->
                <Button Grid.Column="1"
                        Content="Emergency（黒）"
                        Command="{Binding ToggleEmergencyBlackCommand}"
                        FontWeight="Bold"
                        Height="28" MinWidth="130"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GrandMaButtonStyle}">
                            <Setter Property="Background" Value="#333333"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmergencyBlackActive}" Value="True">
                                    <Setter Property="Background" Value="#DC3545"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- NO.38: 上部の信号Off/Onトグルは削除。信号Offはコマンドパネル「動作:」内の
                     信号Offボタン（選択行Cmd=SignalOff上書き）および Cmd ドロップダウンから使用する。 -->

                <Button Grid.Column="3"
                        Content="■ 停止"
                        Command="{Binding StopExecutionCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        Foreground="#FF5252"
                        FontWeight="Bold"
                        Height="28" Width="80"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        ToolTip="実行中のエフェクトを停止（Esc キーと同じ動作）"/>
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="0,0,8,0">
                    <Run Text="操作キー: "/>
                    <Run Text="Enter" Foreground="#FFC107" FontWeight="Bold"/>
                    <Run Text="=実行+次へ "/>
                    <Run Text="←" Foreground="#FFC107" FontWeight="Bold"/>
                    <Run Text="=前へ+実行 "/>
                    <Run Text="→" Foreground="#FFC107" FontWeight="Bold"/>
                    <Run Text="=次へ移動 "/>
                    <Run Text="Esc" Foreground="#FFC107" FontWeight="Bold"/>
                    <Run Text="=停止"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ============ 上半分：DataGrid（最大化）============ -->
        <DataGrid x:Name="StepDataGrid"
                  Grid.Row="2"
                  Style="{StaticResource GrandMaDataGridStyle}"
                  ItemsSource="{Binding EditingSteps}"
                  SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                  SelectedIndex="{Binding CurrentStepIndex, Mode=TwoWay}"
                  IsEnabled="{Binding HasSelectedSequence}"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  BeginningEdit="StepDataGrid_BeginningEdit"
                  CellEditEnding="StepDataGrid_CellEditEnding"
                  Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No"
		                          Binding="{Binding RowNumber, UpdateSourceTrigger=LostFocus, Converter={x:Static conv:NonNegativeIntegerOrBlankConverter.Instance}}"
		                          Width="50"
		                          IsReadOnly="False"/>

                <DataGridTemplateColumn Header="Lock" Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Background="#333" Foreground="White"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="コメント"
		                          Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
		                          Width="130"/>

                <DataGridTextColumn Header="SubSeq"
		                          Binding="{Binding SubSequenceComment, UpdateSourceTrigger=PropertyChanged}"
		                          Width="100"/>

                <DataGridTextColumn Header="Preset Seq"
		                          Binding="{Binding PresetSequenceName, UpdateSourceTrigger=PropertyChanged}"
		                          Width="100"/>

                <DataGridTextColumn Header="Frame"
		                          Binding="{Binding FrameNo, UpdateSourceTrigger=PropertyChanged}"
		                          Width="50"/>

                <DataGridTextColumn Header="Time(秒)"
		                          Binding="{Binding TimeSec, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0##}}"
		                          Width="65"/>

                <DataGridTextColumn Header="BPM"
		                          Binding="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}"
		                          Width="50"/>

                <DataGridComboBoxColumn Header="コマンド"
		                              ItemsSource="{StaticResource CommandTypeOptions}"
		                              SelectedValueBinding="{Binding CommandType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		                              Width="95"/>

                <!-- カラープレビュー列 -->
                <DataGridTemplateColumn Header="色" Width="30" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="20" Height="16"
                                    CornerRadius="3"
                                    BorderBrush="#666" BorderThickness="1"
                                    Background="{Binding ColorPreviewBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="R"
		                          Binding="{Binding ColorR, UpdateSourceTrigger=PropertyChanged}"
		                          Width="45"/>
                <DataGridTextColumn Header="G"
		                          Binding="{Binding ColorG, UpdateSourceTrigger=PropertyChanged}"
		                          Width="45"/>
                <DataGridTextColumn Header="B"
		                          Binding="{Binding ColorB, UpdateSourceTrigger=PropertyChanged}"
		                          Width="45"/>

                <DataGridTextColumn Header="再送"
		                          Binding="{Binding RetransmitCount, UpdateSourceTrigger=PropertyChanged}"
		                          Width="45"/>

                <DataGridComboBoxColumn Header="エフェクト"
		                              ItemsSource="{StaticResource EffectTypeOptions}"
		                              SelectedValueBinding="{Binding EffectTypeDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
		                              Width="105"/>

                <DataGridTextColumn Header="周期(ms)"
		                          Binding="{Binding EffectCycleDurationMs, UpdateSourceTrigger=PropertyChanged}"
		                          Width="70"/>

                <DataGridTextColumn Header="Fade"
		                          Binding="{Binding FadeSteps, UpdateSourceTrigger=PropertyChanged}"
		                          Width="55"/>

                <DataGridTextColumn Header="メモ"
		                          Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
		                          Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ============ 下半分：プリセット選択 + Save ============ -->
        <Border Grid.Row="3"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="8" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 0: 色プリセット -->
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>   <!-- 2: Custom 色プリセット -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- 4: 動作プリセット -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- 6: 煽り プリセット（押下中点灯）-->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- 8: 操作行 -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- 10: 簡単登録 -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- 12: テンプレ -->
                </Grid.RowDefinitions>

                <!-- 色プリセット -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding ColorPresets}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectColorPresetCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                                        Tag="{Binding IsSelected}"
                                        MinWidth="86" MinHeight="32"
                                        Margin="0,0,4,4"
                                        Padding="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding Hex}"
                                                 Width="12" Height="12"
                                                 Stroke="#FFFFFF" StrokeThickness="1"
                                                 Margin="6,0,4,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Custom 色プリセット（右クリックで編集）-->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Custom:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               ToolTip="現場で発色調整するための中間色枠（右クリックで色を編集）"/>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding CustomColorPresets}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCustomColorPresetCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                                        Tag="{Binding IsSelected}"
                                        MinWidth="110" MinHeight="32"
                                        Margin="0,0,4,4"
                                        Padding="0"
                                        ToolTip="クリック=選択行に色を反映 / 右クリック=色を編集">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="色を編集..."
                                                      Click="CustomColorEdit_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding Hex}"
                                                 Width="12" Height="12"
                                                 Stroke="#FFFFFF" StrokeThickness="1"
                                                 Margin="6,0,4,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="✏"
                                                   FontSize="10"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   ToolTip="右クリックで色を編集"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 動作プリセット -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="動作:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding ActionPresets}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectActionPresetCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                                        Tag="{Binding IsSelected}"
                                        MinWidth="100" MinHeight="32"
                                        Margin="0,0,4,4"
                                        Padding="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Fill="{Binding AccentHex}"
                                                   Width="4"
                                                   Margin="6,3,4,3"
                                                   RadiusX="2" RadiusY="2"
                                                   VerticalAlignment="Stretch"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 煽り プリセット（押している間 LED 点灯、離すと元に戻る）-->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="煽り:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               ToolTip="短押し=ピカ一発 / 長押し=押下中ずっと点灯 / 右クリックで色を編集"/>
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding AggressiveColorPresets}"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GrandMaButtonStyle}"
                                        MinWidth="120" MinHeight="36"
                                        Margin="0,0,4,4"
                                        Padding="0"
                                        Foreground="#FFC107"
                                        FontWeight="Bold"
                                        PreviewMouseLeftButtonDown="AggressiveButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="AggressiveButton_PreviewMouseLeftButtonUp"
                                        MouseLeave="AggressiveButton_MouseLeave"
                                        LostMouseCapture="AggressiveButton_LostMouseCapture"
                                        ToolTip="短押し=ピカ一発 / 長押し=押下中点灯 / 右クリック=色を編集">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="色を編集..."
                                                      Click="AggressiveColorEdit_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding Hex}"
                                                 Width="14" Height="14"
                                                 Stroke="#FFFFFF" StrokeThickness="1"
                                                 Margin="6,0,4,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock Text="✏"
                                                   FontSize="10"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   ToolTip="右クリックで色を編集"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 操作行：行操作ボタン群 -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="操作:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Button Content="+ 追加"
                                Command="{Binding AddEmptyStepCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaSelectableButtonStyle}"
                                Tag="True"
                                MinHeight="34" Width="90"
                                FontWeight="Bold"
                                Margin="0,0,4,0"
                                ToolTip="選択中の行の直後に空行を挿入"/>
                        <Button Content="複製"
                                Command="{Binding DuplicateStepCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="70"
                                Margin="0,0,4,0"
                                ToolTip="選択中の行を直後に複製（時刻は +1000ms）"/>
                        <Button Content="▲"
                                Command="{Binding MoveStepUpCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="40"
                                FontWeight="Bold"
                                Margin="0,0,2,0"
                                ToolTip="選択中の行を 1 つ上へ移動"/>
                        <Button Content="▼"
                                Command="{Binding MoveStepDownCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="40"
                                FontWeight="Bold"
                                Margin="0,0,4,0"
                                ToolTip="選択中の行を 1 つ下へ移動"/>
                        <Button Content="時刻順ソート"
                                Command="{Binding SortByTimeCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="100"
                                Margin="0,0,4,0"
                                ToolTip="全ステップを開始時刻（ms）で昇順にソート"/>
                        <!-- F2: ステップ番号順ソートボタン -->
                        <Button Content="No順ソート"
                                Command="{Binding SortByStepNumberCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="90"
                                Margin="0,0,4,0"
                                ToolTip="全ステップをNo列の番号（0 以上の整数）で昇順にソート"/>
                        <!-- NO.20: 全クリアボタン削除（押し間違い防止） -->
                        <Button Content="行削除"
                                Command="{Binding RemoveStepCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="34" Width="80"
                                Foreground="#FF5252"
                                ToolTip="選択中の行を削除"/>
                    </StackPanel>
                </Grid>

                <!-- 簡単登録：選択中の色プリセットで Color / Off ステップを末尾に追加 -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="簡単登録:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="色"
                                Command="{Binding EasyAddColorCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="60"
                                Margin="0,0,4,0"
                                ToolTip="上の色プリセットを選択中の色で Color ステップを末尾に追加"/>
                        <Button Content="OFF"
                                Command="{Binding EasyAddOffCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="60"
                                Margin="0,0,12,0"
                                ToolTip="Off ステップを末尾に追加"/>
                        <TextBlock Text="間隔(ms):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="80"
                                 Text="{Binding EasyIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource GrandMaTextBoxStyle}"
                                 HorizontalContentAlignment="Right"
                                 Padding="6,2"
                                 MinHeight="28"
                                 ToolTip="連続追加時の時刻間隔（既定 500ms）"/>
                    </StackPanel>
                </Grid>

                <!-- テンプレ：複数ステップをまとめて末尾に追加 -->
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="テンプレ:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="色変更"
                                Command="{Binding ApplyTemplateColorChangeCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="80"
                                Margin="0,0,4,0"
                                ToolTip="7 色を 1 秒間隔で切り替える Color ステップ 7 件を末尾に追加"/>
                        <Button Content="呼吸"
                                Command="{Binding ApplyTemplateBreathingCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="70"
                                Margin="0,0,4,0"
                                ToolTip="Breathing エフェクト（周期 3000ms、Fade 30）を 1 件追加"/>
                        <Button Content="Flash"
                                Command="{Binding ApplyTemplateFlashCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="70"
                                Margin="0,0,4,0"
                                ToolTip="Flash エフェクト（周期 500ms）を 1 件追加"/>
                        <Button Content="7 色"
                                Command="{Binding ApplyTemplateSevenColorCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="60"
                                Margin="0,0,4,0"
                                ToolTip="SevenColor エフェクト（周期 7000ms、Fade 20）を 1 件追加"/>
                        <Button Content="カウントダウン"
                                Command="{Binding ApplyTemplateCountdownCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="120"
                                Margin="0,0,4,0"
                                ToolTip="5 → 0 を色変化で表現（赤 → 橙 → 黄 → 緑 → 白 → Off、1 秒間隔）"/>
                        <!-- F10: 新フェードテンプレート -->
                        <Button Content="2色FadeIn"
                                Command="{Binding ApplyTemplateTwoColorFadeInCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="100"
                                Margin="0,0,4,0"
                                ToolTip="色1→FadeIn保持→色2→FadeIn保持（各 2000ms、時間変更可能）"/>
                        <Button Content="FadeIn&amp;Out"
                                Command="{Binding ApplyTemplateFadeInOutCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="32" Width="100"
                                Margin="0,0,4,0"
                                ToolTip="FadeIn保持→FadeOut保持（各 2000ms、時間変更可能）"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 送信ログパネル ============ -->
        <Border Grid.Row="4"
                Background="#0A0A0A"
                BorderBrush="{StaticResource AccentAmberBrush}"
                BorderThickness="1"
                Margin="0,0,0,4"
                Height="120">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ヘッダ：タイトル + クリアボタン -->
                <Grid Grid.Row="0" Background="#1A1A1A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="送信ログ"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentAmberBrush}"
                               VerticalAlignment="Center"
                               Padding="8,4"/>
                    <Button Grid.Column="1"
                            Content="クリア"
                            Command="{Binding ClearLogCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="24" Width="60"
                            Margin="0,2,4,2"
                            ToolTip="送信ログをすべて消去"/>
                </Grid>

                <!-- ログ表示 ListBox -->
                <ListBox x:Name="LogListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding LogEntries}"
                         Background="#0A0A0A"
                         BorderThickness="0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyDown="LogListBox_KeyDown"
                         Loaded="LogListBox_Loaded">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"
                                       Foreground="{Binding Color}"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============ ステータスバー ============ -->
        <Border Grid.Row="5"
                Background="#0F0F0F"
                BorderBrush="{StaticResource AccentAmberBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="#FFC107"
                           FontStyle="Italic"
                           VerticalAlignment="Center"/>

                <!-- 連続再生中の現ステップ表示：色プレビュー丸 + シーケンス名 + ステップ詳細 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- 現ステップの色プレビュー -->
                    <Ellipse Width="14" Height="14"
                             Fill="{Binding PlayingStepColorHex}"
                             Stroke="#7CFF7C"
                             StrokeThickness="1"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>

                    <TextBlock FontSize="11"
                               Foreground="#7CFF7C"
                               FontWeight="Bold"
                               VerticalAlignment="Center">
                        <Run Text="● "/>
                        <Run Text="{Binding PlayingSequenceName}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding PlayingStepLabel}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
