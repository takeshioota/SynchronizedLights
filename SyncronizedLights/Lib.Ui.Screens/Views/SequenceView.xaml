<UserControl x:Class="Lib.Ui.Screens.Views.SequenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Margin="8">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Sequence01"
                    Width="120"
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding SendSequenceCommand}"
                    CommandParameter="Sequence01" />

            <Button Content="Sequence02"
                    Width="120"
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding SendSequenceCommand}"
                    CommandParameter="Sequence02" />

            <Button Content="Sequence03"
                    Width="120"
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding SendSequenceCommand}"
                    CommandParameter="Sequence03" />

            <Button Content="Sequence04"
                    Width="120"
                    Height="40"
                    Command="{Binding SendSequenceCommand}"
                    CommandParameter="Sequence04" />
        </StackPanel>

        <TextBlock Text="{Binding StatusText}"
                   Margin="0,8,0,4"
                   FontSize="16"
                   Foreground="White" />

        <TextBlock Text="{Binding QueueText}"
                   FontSize="14"
                   Foreground="LightGray" />
    </StackPanel>
</UserControl>