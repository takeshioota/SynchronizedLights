{
  "Lighting": {
    "Mode": "Real",
    //"Mode": "Dummy",
    // "DataDirectory": "data",  // 未指定時は %LocalAppData%\SynchronizedLights。相対パスは exe 基準。
    "ApiBaseUrl": "http://localhost:5100",
    "ApiExePath": "Api\\SynchrolightAPI.Api.exe",
    "AutoConnectOnStartup": true,
    "SendQueueCapacity": 256,
    "SendIntervalMs": 5,
    "DefaultChannel": 4,
    "DefaultPower": 3,

    "QueuePolicy": "Wait",
    "QueueDropThreshold": 0.95,

    "DummySendDelayMs": 100,

    "LatencyEnabled": true,
    "LatencyWindowSize": 1000,
    "LatencyLogIntervalSec": 30,

    "AutoReconnectEnabled": true,
    "ReconnectIntervalSec": 5,

    "HeartbeatEnabled": true,
    "HeartbeatIntervalSec": 30,

    "KeepAliveEnabled": true,
    "KeepAliveIntervalMs": 800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  }
}
