<Application x:Class="SynchronizedLights.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lib.Ui.Screens.Views;assembly=Lib.Ui.Screens"
             xmlns:viewModels="clr-namespace:Lib.Ui.Screens.ViewModels;assembly=Lib.Ui.Screens"
             StartupUri="IntegratedWindow.xaml">
    <Application.Resources>

        <!-- 基本色 -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#111111"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PanelBgBrush2" Color="#202020"/>
        <SolidColorBrush x:Key="BorderBrushAmber" Color="#D6A100"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#252525"/>
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#3A2E00"/>
        <SolidColorBrush x:Key="ButtonSelectedBrush" Color="#D6A100"/>
        <SolidColorBrush x:Key="ButtonSelectedBorderBrush" Color="#FFE27A"/>
        <SolidColorBrush x:Key="ButtonSelectedTextBrush" Color="#111111"/>
        <SolidColorBrush x:Key="TextBrushMain" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextBrushSub" Color="#D0D0D0"/>

        <!-- TextBlock -->
        <Style x:Key="GrandMaTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}" />
        </Style>

        <!-- セクション見出し -->
        <Style x:Key="GrandMaSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource GrandMaTextBlockStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 共通ボタン -->
        <Style x:Key="GrandMaButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}" />
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFD84A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFE27A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 選択中ボタン -->
        <Style x:Key="GrandMaSelectableButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GrandMaButtonStyle}">
            <Style.Triggers>
                <!-- DataTrigger で Tag を明示的に監視 -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ButtonSelectedBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2.5" />
                    <Setter Property="Foreground" Value="{StaticResource ButtonSelectedTextBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- パネルBorder -->
        <Style x:Key="GrandMaPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- ComboBoxItem スタイル ― ドロップダウン内の1項目 -->
        <Style x:Key="GrandMaComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox スタイル ― 本体（アンバー枠 + ダーク背景 + 白文字） -->
        <Style x:Key="GrandMaComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource GrandMaComboBoxItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>

                            <!-- 背景・枠線 -->
                            <Border x:Name="Border"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True"/>

                            <!-- 選択中の項目表示 -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>

                            <!-- ドロップダウン開閉ボタン + 矢印 -->
                            <ToggleButton Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Width="10" Height="6"
                                                  Stretch="Uniform"
                                                  Fill="{StaticResource TextBrushMain}"
                                                  Data="M 0 0 L 5 5 L 10 0 Z"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FFD84A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- ドロップダウン本体 -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource PanelBgBrush}"
                                        BorderBrush="{StaticResource BorderBrushAmber}"
                                        BorderThickness="1.2"
                                        CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD84A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox スタイル -->
        <Style x:Key="GrandMaTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrushMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#3A2E00"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFD84A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFE27A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox スタイル ― grandMA2風アンバー -->
        <Style x:Key="GrandMaCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrushMain}"/>
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- チェック枠 -->
                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="20" Height="20"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <!-- チェックマーク（初期は非表示、IsChecked で表示） -->
                                <Path x:Name="CheckMark"
                                      Data="M 3 7 L 8 12 L 16 4"
                                      Stroke="{StaticResource TextBrushMain}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      SnapsToDevicePixels="True"/>
                            </Border>

                            <!-- ラベル -->
                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#3A2E00"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FFD84A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <DataTemplate DataType="{x:Type viewModels:PresetViewModel}">
            <views:PresetView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ModeViewModel}">
            <views:ModeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AnimationViewModel}">
            <views:AnimationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:SettingViewModel}">
            <views:SettingView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:TimeSequenceViewModel}">
            <views:TimeSequenceView />
        </DataTemplate>

        <!--罫線枠：アンバー-->
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#E69F2C"/>
        
    </Application.Resources>
</Application>