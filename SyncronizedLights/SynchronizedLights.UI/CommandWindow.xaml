<Window x:Class="SynchronizedLights.UI.CommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lib.Ui.Screens.Views;assembly=Lib.Ui.Screens"
        Title="Command Panel"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="400"
        MinHeight="300"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}">

    <views:CommandPanelView DataContext="{Binding}"/>
</Window>
