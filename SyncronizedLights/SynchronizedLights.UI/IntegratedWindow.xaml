<Window x:Class="SynchronizedLights.UI.IntegratedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:views="clr-namespace:Lib.Ui.Screens.Views;assembly=Lib.Ui.Screens"
        xmlns:conv="clr-namespace:Lib.Ui.Screens.Converters;assembly=Lib.Ui.Screens"
        mc:Ignorable="d"
        Title="SynchronizedLights"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="600"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}"
        PreviewKeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- DataGrid ドロップダウン候補 -->
        <x:Array x:Key="CommandTypeOptions" Type="sys:String">
            <sys:String>Color</sys:String>
            <!-- NO.35: Color2（2色交互点灯）はボタン・コマンドとも廃止 -->
            <sys:String>Off</sys:String>
            <sys:String>Effect</sys:String>
            <sys:String>EffectStop</sys:String>
            <sys:String>Rainbow</sys:String>
            <sys:String>RainbowStop</sys:String>
            <sys:String>RainbowPause</sys:String>
            <sys:String>SignalOff</sys:String>
            <sys:String>Preset</sys:String>
            <sys:String>InternalProgram</sys:String>
        </x:Array>
        <x:Array x:Key="EffectTypeOptions" Type="sys:String">
            <x:Static Member="sys:String.Empty"/>
            <sys:String>Flash</sys:String>
            <sys:String>FadeIn</sys:String>
            <sys:String>FadeIn/In</sys:String>
            <sys:String>FadeOut</sys:String>
            <sys:String>FadeOut/Out</sys:String>
            <sys:String>Breathing</sys:String>
            <sys:String>SevenColor</sys:String>
        </x:Array>

        <!-- DataGrid スタイル（SequenceEditorWindow から移植）-->
        <Style x:Key="GrandMaDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                                <Path x:Name="SortArrow" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,6,0" Fill="#111111"
                                      RenderTransformOrigin="0.5,0.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 6 L 4 0 L 8 6 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 6 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GrandMaDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                    <Setter Property="Foreground" Value="#111111"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GrandMaDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#1F1F1F"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A2E00"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                    <!-- NO.41: 選択行(黄背景)の文字を黒系に統一し視認性を確保（白文字対策） -->
                    <Setter Property="Foreground" Value="#111111"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                    <Setter Property="BorderBrush" Value="#7CFF7C"/>
                    <Setter Property="BorderThickness" Value="0,2,0,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GrandMaDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GrandMaDataGridColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource GrandMaDataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource GrandMaDataGridRowStyle}"/>
        </Style>
        <!-- 0値で暗くする ElementStyle（数値列用） -->
        <Style x:Key="ZeroDimTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="#333333"/>
                </Trigger>
                <!-- NO.41: 選択行(黄背景)では数値も黒系にして視認性を確保（0トリガより後＝選択時優先） -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#111111"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- No列: 0（未設定）を空欄表示にするスタイル -->
        <Style x:Key="ZeroBlankTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Style.Triggers>
                <!-- NO.41: 選択行は黒系（0トリガより前＝0の空欄(Transparent)表示は維持） -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#111111"/>
                </DataTrigger>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <!-- 0: ステータスバー -->
            <RowDefinition Height="Auto"/>
            <!-- 1: メインコンテンツ -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== ステータスバー ========== -->
        <Border Grid.Row="0" Style="{StaticResource GrandMaPanelBorderStyle}" Padding="4,2" Margin="0,0,0,4">
            <DockPanel DataContext="{Binding CommandVm}">
                <!-- 右寄せボタン群 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleCommandLogButton" Content="ログを隠す"
                            Click="ToggleCommandLog_Click"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="28" Padding="8,2" Margin="4,0"
                            ToolTip="コマンドログの表示/非表示を切り替え（本番中は非表示で画面を広く使えます）"/>
                    <Button x:Name="ToggleCommandPanelButton" Content="分離"
                            Click="ToggleCommandPanel_Click"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="28" Padding="8,2" Margin="4,0"
                            ToolTip="コマンドパネルを別ウィンドウに分離/統合"/>
                    <Button Content="Settings" Command="{Binding ShowSettingsDialogCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="28" Padding="8,2" Margin="4,0"/>
                    <Button Content="Color" Command="{Binding OpenColorPickerCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="28" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Exit" Command="{Binding PowerExitCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="28" Padding="8,2" Foreground="#FF5252" FontWeight="Bold"/>
                </StackPanel>

                <!-- 左側: 接続状態 (v3.9: Connected: ●/○ 形式) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Connected:" FontSize="11" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="○"/>
                                <Setter Property="Foreground" Value="#FF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransportConnected}" Value="True">
                                        <Setter Property="Text" Value="●"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PortAStatusLabel}" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding PortBStatusLabel}" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- 初期化状態 -->
                    <Border BorderBrush="#555" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TransmitterInitLabel}" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTransmitterInitialized}" Value="True">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               FontSize="11" Foreground="#FFC107" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== メインコンテンツ ========== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- 上段: シーケンス一覧 + エディタ -->
                <RowDefinition Height="*"/>
                <!-- スプリッタ（コマンドログ非表示時は高さ0に折り畳む） -->
                <RowDefinition x:Name="CommandLogSplitterRow" Height="6"/>
                <!-- 下段: コマンドログ（本番中は非表示可。トグルで折り畳み） -->
                <RowDefinition x:Name="CommandLogRow" Height="120" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- ============ 上段: シーケンス一覧(左) + エディタ(右) ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="150"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- シーケンス一覧 -->
                <Border Grid.Column="0" Style="{StaticResource GrandMaPanelBorderStyle}" Padding="6">
                    <Grid DataContext="{Binding SequenceVm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="シーケンス一覧" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource BorderBrushAmber}" Margin="0,0,0,6"/>
                        <!-- v3.9: 進行ロックボタン -->
                        <Button Grid.Row="1" Content="{Binding ProgressLockButtonText}"
                                Command="{Binding ToggleProgressLockCommand}"
                                FontWeight="Bold" MinHeight="36" Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GrandMaSelectableButtonStyle}">
                                    <Setter Property="Tag" Value="{Binding IsProgressLocked}"/>
                                    <Setter Property="Foreground" Value="#FFC107"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 2026-07-16 オペレータ要望: シーケンス一覧を見やすく。
                             フォント既定(約12px)→16px(約130%)、各行に上下余白を付与し行高を約130%に。 -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Sequences}"
                                 SelectedItem="{Binding SelectedSequence, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 FontSize="16"
                                 Background="#0F0F0F" Foreground="#F2F2F2"
                                 BorderBrush="{StaticResource BorderBrushAmber}" BorderThickness="1"
                                 Margin="0,0,0,4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,6"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <!-- 新規（全幅） -->
                        <Button Grid.Row="3" Content="新規" Command="{Binding NewSequenceCommand}"
                                Style="{StaticResource GrandMaButtonStyle}" MinHeight="28" Margin="0,0,0,4"/>
                        <!-- 削除 / 複製（2列） -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="削除" Command="{Binding DeleteSequenceCommand}"
                                    IsEnabled="{Binding HasSelectedSequence}"
                                    Style="{StaticResource GrandMaButtonStyle}" MinHeight="28" Margin="0,0,2,0"/>
                            <Button Grid.Column="1" Content="複製" Command="{Binding DuplicateSequenceCommand}"
                                    IsEnabled="{Binding HasSelectedSequence}"
                                    Style="{StaticResource GrandMaButtonStyle}" MinHeight="28" Margin="2,0,0,0"/>
                        </Grid>
                        <!-- 更新（全幅） -->
                        <Button Grid.Row="5" Content="更新" Command="{Binding RefreshListCommand}"
                                Style="{StaticResource GrandMaButtonStyle}" MinHeight="28" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- スプリッタ(縦) -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Background="#2A2A2A" Width="6"/>

                <!-- シーケンスエディタ -->
                <Grid Grid.Column="2" DataContext="{Binding SequenceVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- 名前 + 保存 -->
                <Border Grid.Row="0" Style="{StaticResource GrandMaPanelBorderStyle}"
                        Padding="8,4" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="名前：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Width="280"
                                 Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelectedSequence}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Padding="6,2" MinHeight="30" Margin="0,0,12,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNameDuplicate}" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Separator Width="1" Background="#444" Margin="0,4,12,4"/>
                        <Button Content="保存" Command="{Binding SaveSequenceCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}" MinHeight="30" Width="70"/>
                        <TextBlock Text="{Binding NameErrorMessage}" Foreground="#FF6B6B" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNameDuplicate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ステップ表示 + BlackOut + 実行/戻る + 操作キーガイド -->
                <Border Grid.Row="1" Background="#0F0F0F"
                        BorderBrush="{StaticResource BorderBrushAmber}" BorderThickness="1,1,1,0"
                        Padding="8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentStepLabel}"
                                   Foreground="#FFC107" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <!-- 実行/戻る/停止（キーボード断線時の予備） -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="◀ 戻る" Command="{Binding PreviousStepCommand}"
                                    Style="{StaticResource GrandMaButtonStyle}"
                                    FontWeight="Bold" Height="32" MinWidth="70" Margin="0,0,4,0"/>
                            <Button Content="実行 ▶" Command="{Binding ExecuteCurrentStepCommand}"
                                    Style="{StaticResource GrandMaButtonStyle}"
                                    FontWeight="Bold" Height="32" MinWidth="70" Margin="0,0,4,0"/>
                            <Button Content="■ 停止" Command="{Binding StopExecutionCommand}"
                                    Style="{StaticResource GrandMaButtonStyle}"
                                    Foreground="#FF5252"
                                    FontWeight="Bold" Height="32" MinWidth="70"
                                    ToolTip="実行中のエフェクトを停止（Esc キーと同じ動作）"/>
                        </StackPanel>
                        <!-- 操作キーガイド -->
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#888888" Margin="0,0,8,0">
                            <Run Text="Enter" Foreground="#FFC107" FontWeight="Bold"/>
                            <Run Text="=実行 "/>
                            <Run Text="←" Foreground="#FFC107" FontWeight="Bold"/>
                            <Run Text="=戻る "/>
                            <Run Text="→" Foreground="#FFC107" FontWeight="Bold"/>
                            <Run Text="=次へ "/>
                            <Run Text="Esc" Foreground="#FFC107" FontWeight="Bold"/>
                            <Run Text="=停止"/>
                        </TextBlock>
                        <!-- Emergency（白）/ Emergency（黒） -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                            <!-- NO.23: Emergency White 削除（Black のみ） -->
                            <Button Content="Emergency&#x0a;Black"
                                    Command="{Binding ToggleEmergencyBlackCommand}"
                                    FontWeight="Bold" Height="42" MinWidth="90" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GrandMaButtonStyle}">
                                        <Setter Property="Background" Value="#333333"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmergencyBlackActive}" Value="True">
                                                <Setter Property="Background" Value="#DC3545"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- NO.38: 右上の信号Off/Onトグルは削除。信号Offはコマンドパネル「動作:」内のボタン
                                 （選択行Cmd=SignalOff上書き）および Cmd ドロップダウンから使用する。 -->
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- v3.9: 煽りボタン（本番中使用エリア） -->
                <Border Grid.Row="2" Background="#1A1200"
                        BorderBrush="#5D4E00" BorderThickness="1" Padding="6,3" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="煽り:" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#FFC107" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AggressiveColorPresets}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GrandMaButtonStyle}"
                                            MinWidth="120" MinHeight="36" Margin="0,0,4,2" Padding="0"
                                            Foreground="#FFC107" FontWeight="Bold"
                                            PreviewMouseLeftButtonDown="AggressiveButton_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="AggressiveButton_PreviewMouseLeftButtonUp"
                                            MouseLeave="AggressiveButton_MouseLeave"
                                            LostMouseCapture="AggressiveButton_LostMouseCapture"
                                            ToolTip="短押し=ピカ一発 / 長押し=押下中点灯 / 右クリック=色を編集">
                                        <Button.ContextMenu>
                                            <ContextMenu><MenuItem Header="色を編集..." Click="AggressiveColorEdit_Click"/></ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Fill="{Binding Hex}" Width="14" Height="14" Stroke="#FFFFFF" StrokeThickness="1" Margin="6,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="&#x270F;" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <!-- 2026-07-06 オペレータ要望: 押し間違い防止のため列ヘッダークリックソートを無効化（CanUserSortColumns="False"）。
                     機能は温存（Sorting配線／StepDataGrid_Sorting／SortEditingStepsByColumn はそのまま）。
                     再有効化は CanUserSortColumns を True に戻すか同属性を削除する。共有スタイルより優先されるローカル指定。 -->
                <DataGrid x:Name="StepDataGrid" Grid.Row="3"
                          CanUserSortColumns="False"
                          Style="{StaticResource GrandMaDataGridStyle}"
                          ItemsSource="{Binding EditingSteps}"
                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                          SelectedIndex="{Binding CurrentStepIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasSelectedSequence}"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          BeginningEdit="StepDataGrid_BeginningEdit"
                          CellEditEnding="StepDataGrid_CellEditEnding"
                          SelectionChanged="StepDataGrid_SelectionChanged"
                          PreviewMouseLeftButtonDown="StepDataGrid_PreviewMouseLeftButtonDown"
                          Sorting="StepDataGrid_Sorting"
                          Margin="0,0,0,4">
                    <DataGrid.Columns>
                        <!-- No 欄機能変更仕様(0825): 00.0 形式(整数2桁/小数1桁, 範囲00.0〜99.9)。空欄=未設定。
                             小数2桁以上・範囲外は ValidationRule で赤枠＋ツールチップ表示（値は未確定）。 -->
                        <DataGridTextColumn Header="No" Width="50" IsReadOnly="False"
                                            ElementStyle="{StaticResource ZeroBlankTextStyle}">
                            <DataGridTextColumn.Binding>
                                <Binding Path="RowNumber" UpdateSourceTrigger="LostFocus"
                                         Converter="{x:Static conv:SequenceNoConverter.Instance}">
                                    <Binding.ValidationRules>
                                        <conv:SequenceNoValidationRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="ToolTip"
                                                    Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTextColumn Header="Time(sec)"
                                            Binding="{Binding TimeSec, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0##}}"
                                            Width="65"/>
                        <DataGridTextColumn Header="Trig" Binding="{Binding Trig}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="BPM" Binding="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridComboBoxColumn Header="Cmd" ItemsSource="{StaticResource CommandTypeOptions}"
                                                SelectedValueBinding="{Binding CommandType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <!-- Rainbow 見える化・行編集列（20260904）：Rainbow 行はパレットとモードを一覧表示し、
                             右クリック「Rainbow編集…」またはダブルクリックで行専用エディタを開く。 -->
                        <DataGridTemplateColumn Header="Rainbow" Width="180" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            ToolTip="ダブルクリック／右クリックで Rainbow の色・モードを編集"
                                            MouseLeftButtonDown="RainbowCell_MouseLeftButtonDown">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rainbow編集…" Click="RowRainbowEdit_Click"
                                                          IsEnabled="{Binding IsRainbow}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRainbow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ItemsControl ItemsSource="{Binding RainbowDisplayColors}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="12" Height="12" Margin="1,0" CornerRadius="2"
                                                                BorderBrush="#555" BorderThickness="1"
                                                                Background="{Binding HexColor}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RainbowSummary}" Margin="4,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11" Foreground="#CCC"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="30" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="20" Height="16" CornerRadius="3"
                                            BorderBrush="#666" BorderThickness="1"
                                            Background="{Binding ColorPreviewBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="R" Binding="{Binding ColorR, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridTextColumn Header="G" Binding="{Binding ColorG, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridTextColumn Header="B" Binding="{Binding ColorB, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridComboBoxColumn Header="FX" ItemsSource="{StaticResource EffectTypeOptions}"
                                                SelectedValueBinding="{Binding EffectTypeDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="Speed(ms)" Binding="{Binding EffectCycleDurationMs, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridTextColumn Header="Fade(ms)" Binding="{Binding FadeSteps, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridTextColumn Header="Preset Seq" Binding="{Binding PresetSequenceName, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Frame" Binding="{Binding FrameNo, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                        <DataGridTextColumn Header="Memo" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="TX" Binding="{Binding RetransmitCount, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                            ElementStyle="{StaticResource ZeroDimTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- プリセット選択（CommandPanelView に統合） -->
                <views:CommandPanelView x:Name="InlineCommandPanel" Grid.Row="4" Margin="0,0,0,4"/>

                <!-- ステータスバー -->
                <Border Grid.Row="5" Background="#0F0F0F"
                        BorderBrush="{StaticResource BorderBrushAmber}" BorderThickness="0,1,0,0" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   Foreground="#FFC107" FontStyle="Italic" VerticalAlignment="Center"/>
                        <!-- NO.33: 実行中に常時見えるバージョン表示 -->
                        <TextBlock Grid.Column="2" x:Name="VersionText"
                                   Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="14" Height="14" Fill="{Binding PlayingStepColorHex}"
                                     Stroke="#7CFF7C" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontSize="11" Foreground="#7CFF7C" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="● "/><Run Text="{Binding PlayingSequenceName}"/>
                                <Run Text=" | "/><Run Text="{Binding PlayingStepLabel}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

            <!-- スプリッタ(横) -->
            <GridSplitter x:Name="CommandLogSplitter" Grid.Row="1" HorizontalAlignment="Stretch" Background="#2A2A2A" Height="6"/>

            <!-- ============ 下段: コマンドログ（全幅） ============ -->
            <Border x:Name="CommandLogPanel" Grid.Row="2" Background="#0A0A0A" BorderBrush="{StaticResource BorderBrushAmber}"
                    BorderThickness="1">
                <Grid DataContext="{Binding SequenceVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#1A1A1A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="コマンドログ" FontWeight="Bold"
                                   Foreground="{StaticResource BorderBrushAmber}"
                                   VerticalAlignment="Center" Padding="8,4"/>
                        <Button Grid.Column="1" Content="クリア" Command="{Binding ClearLogCommand}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="22" Width="50" Margin="0,2,4,2"/>
                    </Grid>
                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             ItemsSource="{Binding LogEntries}"
                             Background="#0A0A0A" BorderThickness="0"
                             FontFamily="Consolas, Courier New, monospace" FontSize="11"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyDown="LogListBox_KeyDown"
                             Loaded="LogListBox_Loaded">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="{Binding Color}" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
