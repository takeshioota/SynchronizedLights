<UserControl x:Class="Lib.Ui.Screens.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Row="0"
                       Text="Preset"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushMain}" />

            <!-- 色選択（4色固定パレット + カスタムピッカー起動） -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal">
                <Button x:Name="BtnColorRed"
                        Content="Red"
                        Command="{Binding SelectRedCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsColorRedSelected}"
                        MinWidth="110"
                        MinHeight="56"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnColorGreen"
                        Content="Green"
                        Command="{Binding SelectGreenCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsColorGreenSelected}"
                        MinWidth="110"
                        MinHeight="56"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnColorBlue"
                        Content="Blue"
                        Command="{Binding SelectBlueCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsColorBlueSelected}"
                        MinWidth="110"
                        MinHeight="56"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnColorWhite"
                        Content="White"
                        Command="{Binding SelectWhiteCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsColorWhiteSelected}"
                        MinWidth="110"
                        MinHeight="56"
                        Margin="0,0,20,0" />
                <Button x:Name="BtnColorSwatch"
                        Content="Custom..."
                        Command="{Binding DataContext.OpenColorPickerCommand,
                                 RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsColorCustomSelected}"
                        MinWidth="130"
                        MinHeight="56" />
            </StackPanel>

            <!-- 現在色表示 -->
            <TextBlock Grid.Row="4"
                       Text="{Binding CurrentColorLabel}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushMain}" />

            <!-- 命令名 + ポート選択 -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>
                <!-- 命令名（TxtCommandName） -->
                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="命令名 / Command Name"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrushMain}"/>
                        <TextBlock Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding DataContext.CommandNameCountText,
                                          RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrushMain}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsCommandNameValid,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="False">
                                            <Setter Property="Foreground" Value="#DC3545"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBox x:Name="TxtCommandName"
                             MaxLength="32"
                             Text="{Binding DataContext.CommandName,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCommandNameValid,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="False">
                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="命令名は32文字以内で入力してください。"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
                <!-- ポート選択（CmbPortSelect） -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="送信先 / Port"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrushMain}"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbPortSelect"
				              Style="{StaticResource GrandMaComboBoxStyle}"
				              FontSize="14"
				              MinHeight="36"
				              ItemsSource="{Binding DataContext.PortOptions,
				                            RelativeSource={RelativeSource AncestorType=Window}}"
				              SelectedItem="{Binding DataContext.SelectedPort,
				                            RelativeSource={RelativeSource AncestorType=Window},
				                            Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- アクション：点灯/消灯/実行/終了 -->
            <StackPanel Grid.Row="10"
                        Orientation="Horizontal">
                <Button x:Name="BtnTurnOn"
                        Content="Turn On"
                        Command="{Binding TurnOnCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="56"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnTurnOff"
                        Content="Turn Off"
                        Command="{Binding TurnOffCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="56"
                        Margin="0,0,20,0" />
                <Button x:Name="BtnExecute"
                        Content="実行 / Execute"
                        Command="{Binding DataContext.ExecuteCurrentSettingsCommand,
                                 RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="150"
                        MinHeight="56"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnPower"
                        Content="終了 / Exit"
                        Command="{Binding DataContext.PowerExitCommand,
                                 RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="56" />
            </StackPanel>

            <!-- 状態表示 -->
            <TextBlock Grid.Row="12"
                       Text="{Binding StatusText}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrushMain}" />

            <!-- キュー表示 -->
            <TextBlock Grid.Row="14"
                       Text="{Binding QueueText}"
                       FontSize="16"
                       Foreground="{StaticResource TextBrushMain}" />
        </Grid>
    </ScrollViewer>
</UserControl>