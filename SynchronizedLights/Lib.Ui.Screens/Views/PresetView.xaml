<UserControl x:Class="Lib.Ui.Screens.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Preset"
                   FontSize="28"
                   FontWeight="Bold" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
            <Button x:Name="BtnColorRed"
                    Content="Red"
                    Command="{Binding SelectRedCommand}"
                    MinWidth="120"
                    MinHeight="56"
                    Margin="0,0,10,0" />

            <Button x:Name="BtnColorGreen"
                    Content="Green"
                    Command="{Binding SelectGreenCommand}"
                    MinWidth="120"
                    MinHeight="56"
                    Margin="0,0,10,0" />

            <Button x:Name="BtnColorBlue"
                    Content="Blue"
                    Command="{Binding SelectBlueCommand}"
                    MinWidth="120"
                    MinHeight="56"
                    Margin="0,0,10,0" />

            <Button x:Name="BtnColorWhite"
                    Content="White"
                    Command="{Binding SelectWhiteCommand}"
                    MinWidth="120"
                    MinHeight="56" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="{Binding CurrentColorLabel}"
                   FontSize="18"
                   FontWeight="Bold" />
    </Grid>
</UserControl>