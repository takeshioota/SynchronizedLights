<UserControl x:Class="Lib.Ui.Screens.Views.TimeSequenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Background="{StaticResource AppBgBrush}"
             Foreground="{StaticResource TextBrushMain}">
    <UserControl.Resources>
        <!-- コマンド種別の選択肢 -->
        <x:Array x:Key="CommandOptions" Type="sys:String">
            <sys:String>SetColor</sys:String>
            <sys:String>FadeIn</sys:String>
            <sys:String>FadeOut</sys:String>
            <sys:String>Flash</sys:String>
            <sys:String>Breath</sys:String>
            <sys:String>Off</sys:String>
            <sys:String>SevenColor</sys:String>
        </x:Array>

        <!-- ============================================================
             GrandMA2 PC 風 DataGrid スタイル一式
             ============================================================ -->

        <!-- 列ヘッダ：アンバー背景＋黒太字 -->
        <Style x:Key="GrandMaDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セル：行高さ・パディング・選択時アンバーハイライト -->
        <Style x:Key="GrandMaDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                    <Setter Property="Foreground" Value="#111111"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 行：高さ・交互背景・ホバー -->
        <Style x:Key="GrandMaDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#1F1F1F"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A2E00"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonSelectedBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 本体 -->
        <Style x:Key="GrandMaDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAmber}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GrandMaDataGridColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource GrandMaDataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource GrandMaDataGridRowStyle}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============= 左ペイン：シーケンス一覧 ============= -->
        <Border Grid.Column="0"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="シーケンス一覧"
                           Style="{StaticResource GrandMaSectionTitleStyle}"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         x:Name="LstSequences"
                         ItemsSource="{Binding Sequences}"
                         SelectedItem="{Binding SelectedSequence, Mode=TwoWay}"
                         Background="{StaticResource PanelBgBrush2}"
                         Foreground="{StaticResource TextBrushMain}"
                         BorderBrush="{StaticResource BorderBrushAmber}"
                         BorderThickness="1"
                         FontSize="13">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextBrushSub}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0">
                    <Button Content="新規"
                            Command="{Binding NewSequenceCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="36"
                            Width="120"
                            Margin="0,0,8,0"/>
                    <Button Content="削除"
                            Command="{Binding DeleteSequenceCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="36"
                            Width="120"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============= 右ペイン：編集 ============= -->
        <Border Grid.Column="2"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- セクションタイトル -->
                    <RowDefinition Height="Auto"/>
                    <!-- 名前 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 説明 -->
                    <RowDefinition Height="Auto"/>
                    <!-- ステップヘッダ -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- 行操作ボタン -->
                    <RowDefinition Height="Auto"/>
                    <!-- 保存・破棄 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 状態メッセージ -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="シーケンス編集"
                           Style="{StaticResource GrandMaSectionTitleStyle}"
                           Margin="0,0,0,8"/>

                <!-- 名前 -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="名前 :"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelectedSequence}"
                             Style="{StaticResource GrandMaTextBoxStyle}"
                             MinHeight="28"/>
                </Grid>

                <!-- 説明 -->
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="説明 :"
                               VerticalAlignment="Top"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelectedSequence}"
                             Style="{StaticResource GrandMaTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="48"
                             VerticalContentAlignment="Top"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="ステップ一覧（時刻 / コマンド / 色 / 所要時間 / 再送 / 補間）"
                           FontWeight="SemiBold"
                           Margin="0,4,0,4"/>

                <!-- ============= ステップ DataGrid（GrandMA2 PC 風スタイル） ============= -->
                <DataGrid Grid.Row="4"
                          Style="{StaticResource GrandMaDataGridStyle}"
                          ItemsSource="{Binding EditingSteps}"
                          SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                          IsEnabled="{Binding HasSelectedSequence}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="時刻(秒)"
                                            Binding="{Binding TimeSec, StringFormat={}{0:F2}}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridComboBoxColumn Header="コマンド"
                                                ItemsSource="{StaticResource CommandOptions}"
                                                SelectedValueBinding="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"/>

                        <DataGridTextColumn Header="R"
                                            Binding="{Binding ColorR}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="G"
                                            Binding="{Binding ColorG}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="B"
                                            Binding="{Binding ColorB}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="所要(秒)"
                                            Binding="{Binding DurationSec, StringFormat={}{0:F2}}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="再送"
                                            Binding="{Binding RetransmitCount}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="補間(ms)"
                                            Binding="{Binding InterpolationIntervalMs}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="メモ"
                                            Binding="{Binding Note}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 行操作 -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="行追加"
                            Command="{Binding AddStepCommand}"
                            IsEnabled="{Binding HasSelectedSequence}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="34" Width="110"
                            Margin="0,0,8,0"/>
                    <Button Content="行削除"
                            Command="{Binding RemoveStepCommand}"
                            IsEnabled="{Binding HasSelectedSequence}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="34" Width="110"
                            Margin="0,0,8,0"/>
                    <Button Content="時刻順ソート"
                            Command="{Binding SortStepsCommand}"
                            IsEnabled="{Binding HasSelectedSequence}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            MinHeight="34" Width="140"/>
                </StackPanel>

                <!-- 保存・破棄・再生 -->
                <Grid Grid.Row="6" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：再生 / API 同期 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="{Binding PlayButtonText}"
                                Command="{Binding PlayOrStopCommand}"
                                IsEnabled="{Binding IsApiEnabled}"
                                Style="{StaticResource GrandMaSelectableButtonStyle}"
                                Tag="{Binding IsPlaying}"
                                MinHeight="38" Width="130"
                                Margin="0,0,8,0"
                                ToolTip="現在のシーケンスを API 経由で再生 / 停止します"/>
                        <Button Content="API 同期"
                                Command="{Binding SyncToApiCommand}"
                                IsEnabled="{Binding IsApiEnabled}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="38" Width="120"
                                ToolTip="編集中の内容を API サーバーへ Upsert（再生せず登録のみ）"/>
                    </StackPanel>

                    <!-- 右：編集破棄 / 保存 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="編集破棄"
                                Command="{Binding DiscardChangesCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="38" Width="120"
                                Margin="0,0,8,0"/>
                        <Button Content="保存"
                                Command="{Binding SaveSequenceCommand}"
                                IsEnabled="{Binding HasSelectedSequence}"
                                Style="{StaticResource GrandMaButtonStyle}"
                                MinHeight="38" Width="120"/>
                    </StackPanel>
                </Grid>

                <!-- 状態メッセージ + 再生中表示 -->
                <StackPanel Grid.Row="7" Orientation="Vertical" Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#FFC107"
                               FontStyle="Italic"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock FontSize="11"
                               Foreground="#7CFF7C"
                               FontWeight="Bold"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="● 再生中: "/>
                        <Run Text="{Binding PlayingSequenceName}"/>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
