<UserControl x:Class="Lib.Ui.Screens.Views.AnimationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{StaticResource TextBrushMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Row="0"
                       Text="Animation"
                       FontSize="28"
                       FontWeight="Bold"/>

            <!-- 説明 -->
            <TextBlock Grid.Row="2"
                       Text="Animation パターン一覧：タイルをタップして選択し、「実行」で送信します。"
                       FontSize="13"
                       Opacity="0.85"/>

            <!-- アニメーション一覧 -->
            <ItemsControl Grid.Row="4"
                          ItemsSource="{Binding Animations}"
                          HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectAnimationCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GrandMaSelectableButtonStyle}"
                                Tag="{Binding IsSelected}"
                                FocusVisualStyle="{x:Null}"
                                Width="170"
                                Height="110"
                                Margin="6"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- アイコン（常に中央上部） -->
                                <Rectangle Grid.Row="0"
                                           Width="44"
                                           Height="44"
                                           RadiusX="10"
                                           RadiusY="10"
                                           Fill="{Binding IconBrush}"
                                           Stroke="White"
                                           StrokeThickness="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <!-- 名前（常にタイル下部） -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- プレビュー + 実行ボタン -->
            <Border Grid.Row="6"
                    BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="プレビュー / Preview"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="実行 / Execute"
                            Command="{Binding ExecuteAnimationCommand}"
                            IsEnabled="{Binding HasSelection}"
                            MinWidth="200"
                            MinHeight="48"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>