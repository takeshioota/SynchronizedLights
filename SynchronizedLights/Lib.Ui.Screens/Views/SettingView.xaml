<UserControl x:Class="Lib.Ui.Screens.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{StaticResource TextBrushMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">

            <!-- 画面タイトル -->
            <TextBlock Text="Setting"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- ポート一覧 -->
            <TextBlock Text="COMポート一覧"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Content="{Binding PortName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrushMain}"
                                          VerticalAlignment="Center"
                                          FontSize="14" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectionStatusLabel}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 操作ボタン -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BtnRefreshPorts"
                        Content="更新 / Refresh"
                        Command="{Binding RefreshPortsCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnOpenPorts"
                        Content="接続 / Connect"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnClosePorts"
                        Content="切断 / Disconnect"
                        Command="{Binding DisconnectCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44" />
            </StackPanel>

            <!-- 接続状態 -->
            <TextBlock Text="接続状態"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding PortAStatusLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding PortBStatusLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding ConnectedCountLabel}"
                               FontSize="14"
                               Margin="0,6,0,2" />
                    <TextBlock Text="{Binding QueueLengthLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding LastErrorLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                </StackPanel>
            </Border>

            <!-- 送信機初期設定 -->
            <TextBlock Text="送信機初期設定 (FA/FB)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Channel (FA):"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ChannelValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="6,4"
                                 MinHeight="30" />
                    </Grid>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Power (FB):"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding PowerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Padding="6,4"
                                 MinHeight="30" />
                    </Grid>
                    <Button x:Name="BtnInitializeTransmitter"
                            Content="送信機初期化 / Initialize"
                            Command="{Binding InitializeTransmitterCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="220"
                            MinHeight="40"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ステータスメッセージ -->
            <TextBlock Text="{Binding SettingStatusMessage}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>