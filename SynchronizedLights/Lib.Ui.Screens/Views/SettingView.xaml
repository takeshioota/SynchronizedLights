<UserControl x:Class="Lib.Ui.Screens.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <StackPanel Margin="20">
        <TextBlock Text="Setting"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <Border BorderBrush="Gray"
                BorderThickness="1"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding PortStatusText}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Binding PortCountText}"
                           FontSize="16"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding QueueStatusText}"
                           FontSize="16"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding ErrorStatusText}"
                           FontSize="16"
                           Margin="0,0,0,12" />

                <Button Content="Refresh"
                        Command="{Binding RefreshStatusCommand}"
                        Width="120"
                        Height="40" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>