<UserControl x:Class="Lib.Ui.Screens.Views.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             Foreground="{StaticResource TextBrushMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10,20,20">

            <!-- 画面タイトル -->
            <TextBlock Text="Setting"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- ポート一覧 -->
            <TextBlock Text="COMポート一覧"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Content="{Binding PortName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource GrandMaCheckBoxStyle}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectionStatusLabel}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 操作ボタン -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BtnRefreshPorts"
                        Content="更新 / Refresh"
                        Command="{Binding RefreshPortsCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnOpenPorts"
                        Content="接続 / Connect"
                        Command="{Binding ConnectCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44"
                        Margin="0,0,10,0" />
                <Button x:Name="BtnClosePorts"
                        Content="切断 / Disconnect"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="160"
                        MinHeight="44" />
            </StackPanel>

            <!-- 接続状態 -->
            <TextBlock Text="接続状態"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding PortAStatusLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding PortBStatusLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding ConnectedCountLabel}"
                               FontSize="14"
                               Margin="0,6,0,2" />
                    <TextBlock Text="{Binding QueueLengthLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                    <TextBlock Text="{Binding LastErrorLabel}"
                               FontSize="14"
                               Margin="0,2,0,2" />
                </StackPanel>
            </Border>

            <!-- 送信機初期設定 -->
            <TextBlock Text="送信機初期設定 (FA/FB)"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Channel -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Channel (FA):"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ChannelValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                    <Style.Triggers>
                                        <!-- 1〜4 の範囲外で赤枠 -->
                                        <DataTrigger Binding="{Binding IsChannelValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="ToolTip"
                                                    Value="Channel は 1〜4 の範囲で入力してください。"/>
                                        </DataTrigger>
                                        <!-- byte 変換失敗で赤枠 -->
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="ToolTip"
                                                    Value="Channel は 1〜4 の整数で入力してください。"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Power -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Power (FB):"
                                   VerticalAlignment="Center"
                                   FontSize="14" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding PowerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                    <Style.Triggers>
                                        <!-- 0〜3 の範囲外で赤枠 -->
                                        <DataTrigger Binding="{Binding IsPowerValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="ToolTip"
                                                    Value="Power は 0〜3 の範囲で入力してください。"/>
                                        </DataTrigger>
                                        <!-- byte 変換失敗で赤枠 -->
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="BorderBrush" Value="#DC3545"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="ToolTip"
                                                    Value="Power は 0〜3 の整数で入力してください。"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- 送信機初期化ボタン -->
                    <Button x:Name="BtnInitializeTransmitter"
                            Content="送信機初期化 / Initialize"
                            Command="{Binding InitializeTransmitterCommand}"
                            Style="{StaticResource GrandMaButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="220"
                            MinHeight="40"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ゾーン割当 -->
            <TextBlock Text="ゾーン割当 / Zone Allocation"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8" />
            <Border BorderBrush="{StaticResource AccentAmberBrush}"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="各ゾーンに COM ポート・CH・電力を割り当てます。大規模構成（7〜8万台）の複数発信機運用向け。"
                            FontSize="12"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"/>
        
                    <!-- ヘッダー行 -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ゾーン" FontWeight="SemiBold" Opacity="0.8"/>
                        <TextBlock Grid.Column="1" Text="割当ポート" FontWeight="SemiBold" Opacity="0.8" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="CH (1-4)" FontWeight="SemiBold" Opacity="0.8" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Pwr (0-3)" FontWeight="SemiBold" Opacity="0.8" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="" FontWeight="SemiBold" Opacity="0.8" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="5" Text="状態" FontWeight="SemiBold" Opacity="0.8" Margin="10,0,0,0"/>
                    </Grid>
        
                    <!-- Zones データバインド（MainWindowViewModel.Zones へ） -->
                    <ItemsControl ItemsSource="{Binding DataContext.Zones,
                                        RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
        
                                    <!-- ゾーン名 -->
                                    <TextBlock Grid.Column="0"
                                            Text="{Binding ZoneName}"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"/>
        
                                    <!-- ポート選択 ComboBox -->
                                    <ComboBox Grid.Column="1"
                                            x:Name="CmbZonePort"
                                            ItemsSource="{Binding AvailablePorts}"
                                            SelectedItem="{Binding AssignedPort, Mode=TwoWay}"
                                            Style="{StaticResource GrandMaComboBoxStyle}"
                                            MinHeight="30"
                                            Margin="10,0,0,0"/>
        
                                    <!-- CH TextBox -->
                                    <TextBox Grid.Column="2"
                                            x:Name="TxtZoneCh"
                                            Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MinHeight="30"
                                            Margin="10,0,0,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChannelValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="ToolTip" Value="Channel は 1〜4 の整数"/>
                                                    </DataTrigger>
                                                    <Trigger Property="Validation.HasError" Value="True">
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
        
                                    <!-- Pwr TextBox -->
                                    <TextBox Grid.Column="3"
                                            x:Name="TxtZonePwr"
                                            Text="{Binding Power, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MinHeight="30"
                                            Margin="10,0,0,0">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPowerValid}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="ToolTip" Value="Power は 0〜3 の整数"/>
                                                    </DataTrigger>
                                                    <Trigger Property="Validation.HasError" Value="True">
                                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
        
                                    <!-- 適用ボタン -->
                                    <Button Grid.Column="4"
                                            x:Name="BtnZoneInit"
                                            Content="適用"
                                            Command="{Binding InitializeZoneCommand}"
                                            Style="{StaticResource GrandMaButtonStyle}"
                                            MinWidth="80"
                                            MinHeight="30"
                                            Margin="10,0,0,0"/>
        
                                    <!-- 状態表示 -->
                                    <TextBlock Grid.Column="5"
                                            Text="{Binding ZoneStatusMessage}"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ステータスメッセージ -->
            <TextBlock Text="{Binding SettingStatusMessage}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,10,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>