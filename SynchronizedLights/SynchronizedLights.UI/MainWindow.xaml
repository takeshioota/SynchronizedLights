<Window x:Class="SynchronizedLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowState="Maximized"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- TopBar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="TOP"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold" />

                <Button x:Name="BtnSpeed01"
                        Grid.Column="1"
                        Content="Speed01"
                        Command="{Binding ApplySpeed01Command}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSpeed02"
                        Grid.Column="2"
                        Content="Speed02"
                        Command="{Binding ApplySpeed02Command}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSpeed03"
                        Grid.Column="3"
                        Content="Speed03"
                        Command="{Binding ApplySpeed03Command}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSpeed04"
                        Grid.Column="4"
                        Content="Speed04"
                        Command="{Binding ApplySpeed04Command}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <TextBlock Grid.Column="6"
                        Text="Target:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />

                <TextBlock Grid.Column="7"
                        Text="{Binding CurrentTargetLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />

                <TextBlock Grid.Column="9"
                        Text="Mode:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />

                <TextBlock Grid.Column="10"
                        Text="{Binding CurrentCategory}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />

                <TextBlock Grid.Column="12"
                        Text="Color:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />

                <TextBlock Grid.Column="13"
                        Text="{Binding CurrentColorLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />

                <TextBlock Grid.Column="14"
                        Text="{Binding StatusMessage}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="20,0,10,0" />
            </Grid>
        </Border>

        <!-- MainPanelHost -->
        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Margin="0">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- CategoryMenu -->
        <Border Grid.Row="1"
                Grid.Column="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <StackPanel VerticalAlignment="Stretch">
                <TextBlock Text="CATEGORY"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Button Content="Preset"
                        Command="{Binding ShowPresetCommand}"
                        MinHeight="56"
                        Margin="0,0,0,10" />

                <Button Content="Mode"
                        Command="{Binding ShowModeCommand}"
                        MinHeight="56"
                        Margin="0,0,0,10" />

                <Button Content="Animation"
                        Command="{Binding ShowAnimationCommand}"
                        MinHeight="56"
                        Margin="0,0,0,10" />

                <Button Content="Setting"
                        Command="{Binding ShowSettingCommand}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
            </StackPanel>
        </Border>

        <!-- TargetBar -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TARGET"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold" />

                <Button x:Name="BtnTargetAll"
                        Grid.Column="1"
                        Content="ALL"
                        Command="{Binding SelectTargetAllCommand}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />                        

                <Button x:Name="BtnTargetGroup01"
                        Grid.Column="2"
                        Content="Group01"
                        Command="{Binding SelectTargetGroup01Command}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnTargetGroup02"
                        Grid.Column="3"
                        Content="Group02"
                        Command="{Binding SelectTargetGroup02Command}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnTargetGroup03"
                        Grid.Column="4"
                        Content="Group03"
                        Command="{Binding SelectTargetGroup03Command}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnTargetGroup04"
                        Grid.Column="5"
                        Content="Group04"
                        Command="{Binding SelectTargetGroup04Command}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnTargetGroup05"
                        Grid.Column="6"
                        Content="Group05"
                        Command="{Binding SelectTargetGroup05Command}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- EffectBar -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="EFFECT"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold" />

                <Button x:Name="BtnFxFlash"
                        Grid.Column="1"
                        Content="Flash"
                        Command="{Binding ExecuteFlashCommand}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnFxFadeIn"
                        Grid.Column="2"
                        Content="FadeIn"
                        Command="{Binding ExecuteFadeInCommand}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnFxFadeOut"
                        Grid.Column="3"
                        Content="FadeOut"
                        Command="{Binding ExecuteFadeOutCommand}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnFxStrobeOff"
                        Grid.Column="4"
                        Content="StrobeOff"
                        Command="{Binding ExecuteStrobeOffCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="10,0,0,0" />

            </Grid>
        </Border>

        <!-- SequenceBar -->
        <Border Grid.Row="4"
                Grid.ColumnSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="SEQUENCE"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold" />

                <Button x:Name="BtnSeq01"
                        Grid.Column="1"
                        Content="Sequence01"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSeq02"
                        Grid.Column="2"
                        Content="Sequence02"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSeq03"
                        Grid.Column="3"
                        Content="Sequence03"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSeq04"
                        Grid.Column="4"
                        Content="Sequence04"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button x:Name="BtnSeqStop"
                        Grid.Column="5"
                        Content="Stop"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>