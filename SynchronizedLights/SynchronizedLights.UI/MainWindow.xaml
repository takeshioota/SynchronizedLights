<Window x:Class="SynchronizedLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1280"
        MinHeight="800"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- TopBar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        Text="TOP"
                        Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnSpeed01"
                        Grid.Column="1"
                        Content="Speed01"
                        Command="{Binding ApplySpeed01Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed01Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed02"
                        Grid.Column="2"
                        Content="Speed02"
                        Command="{Binding ApplySpeed02Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed02Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed03"
                        Grid.Column="3"
                        Content="Speed03"
                        Command="{Binding ApplySpeed03Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed03Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed04"
                        Grid.Column="4"
                        Content="Speed04"
                        Command="{Binding ApplySpeed04Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed04Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="6"
                        Text="Target:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="7"
                        Text="{Binding CurrentTargetLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <TextBlock Grid.Column="9"
                        Text="Mode:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="10"
                        Text="{Binding CurrentCategory}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <TextBlock Grid.Column="12"
                        Text="Color:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="13"
                        Text="{Binding CurrentColorLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <Button x:Name="TglStrobeOff"
                        Grid.Column="15"
                        Content="StrobeOff"
                        Command="{Binding ToggleStrobeOffCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsStrobeOffActive}"
                        MinWidth="120"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <StackPanel Grid.Column="17"
                            Grid.ColumnSpan="2"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="{Binding PortAStatusLabel}"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding PortBStatusLabel}"
                               FontWeight="Bold"
                               FontSize="13" />
                </StackPanel>
                <TextBlock Grid.Column="19"
                        Text="{Binding StatusMessage}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="20,0,10,0" />
            </Grid>
        </Border>

        <!-- MainPanelHost -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- CategoryMenu -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <StackPanel VerticalAlignment="Stretch">
                <TextBlock Text="CATEGORY"
                           Style="{StaticResource GrandMaSectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <Button Content="Preset"
                        Command="{Binding ShowPresetCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsPresetSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="Animation"
                        Command="{Binding ShowAnimationCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsAnimationSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="Setting"
                        Command="{Binding ShowSettingCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSettingSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="TimeSeq"
                        Command="{Binding ShowTimeSeqCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTimeSeqSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
            </StackPanel>
        </Border>

        <!-- TargetBar -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        Text="TARGET"
                        Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnTargetAll"
                        Grid.Column="1"
                        Content="ALL"
                        Command="{Binding SelectTargetAllCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetAllSelected}"                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup01"
                        Grid.Column="2"
                        Content="Group01"
                        Command="{Binding SelectTargetGroup01Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup01Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup02"
                        Grid.Column="3"
                        Content="Group02"
                        Command="{Binding SelectTargetGroup02Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup02Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup03"
                        Grid.Column="4"
                        Content="Group03"
                        Command="{Binding SelectTargetGroup03Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup03Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup04"
                        Grid.Column="5"
                        Content="Group04"
                        Command="{Binding SelectTargetGroup04Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup04Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup05"
                        Grid.Column="6"
                        Content="Group05"
                        Command="{Binding SelectTargetGroup05Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup05Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup06"
                        Grid.Column="7"
                        Content="Group06"
                        Command="{Binding SelectTargetGroup06Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup06Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup07"
			            Grid.Column="8"
			            Content="Group07"
			            Command="{Binding SelectTargetGroup07Command}"
			            Style="{StaticResource GrandMaSelectableButtonStyle}"
			            Tag="{Binding IsTargetGroup07Selected}"
			            MinWidth="100"
			            MinHeight="48"
			            Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup08"
			            Grid.Column="9"
			            Content="Group08"
			            Command="{Binding SelectTargetGroup08Command}"
			            Style="{StaticResource GrandMaSelectableButtonStyle}"
			            Tag="{Binding IsTargetGroup08Selected}"
			            MinWidth="100"
			            MinHeight="48"
			            Margin="10,0,0,0" />

            </Grid>
        </Border>

        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="SPEED"
                           Style="{StaticResource GrandMaSectionTitleStyle}"
                           VerticalAlignment="Center" />

                <!-- 列1: Fade 総時間 -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Fade総時間 (ms) :"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="SldSpeedCommon"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="10000"
                            SmallChange="50"
                            LargeChange="500"
                            TickFrequency="1000"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            MinHeight="32"
                            Value="{Binding EditableSpeedValueMs,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2"
                             Margin="8,0,0,0"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditableSpeedText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpeedValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="Speed は 0〜10000 の整数で入力してください。"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 列3: 補間ステップ間隔 -->
                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="補間間隔 (ms) :"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               ToolTip="コマンドとコマンドの間隔。最速 20ms。&#x0a;Fade 総時間 ÷ 補間間隔 = 送信ステップ数"/>
                    <Slider x:Name="SldInterpolationInterval"
                            Grid.Column="1"
                            Minimum="20"
                            Maximum="100"
                            SmallChange="5"
                            LargeChange="10"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            MinHeight="32"
                            Value="{Binding EditableInterpolationIntervalMs,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2"
                             Margin="8,0,0,0"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditableInterpolationIntervalText,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource GrandMaTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInterpolationIntervalValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="#DC3545"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="ToolTip" Value="補間間隔は 20〜100 の整数で入力してください。"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 列5: Fade 補間ステップ数（計算値、読み取り専用） -->
                <Border Grid.Column="5"
                        BorderBrush="{StaticResource BorderBrushAmber}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10,4"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        Background="#1A1A1A">
                    <TextBlock Text="{Binding ComputedFadeStepsLabel}"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#FFC107"
                               VerticalAlignment="Center"
                               ToolTip="Fade 総時間 ÷ 補間間隔 = 送信ステップ数。&#x0a;Effect API の fadeSteps パラメータに渡される。"/>
                </Border>
            </Grid>
        </Border>

        <!-- EffectBar -->
        <Border Grid.Row="4"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                            Text="EFFECT"
                            Style="{StaticResource GrandMaSectionTitleStyle}" />
                <!-- 単発/連続 トグル：単発=グレー / 連続=アンバー（動的） -->
                <Button x:Name="BtnFxToggleContinuous"
                        Grid.Column="1"
                        Command="{Binding ToggleContinuousModeCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsContinuousMode}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0"
                        ToolTip="ON の間、Flash / FadeIn / FadeOut / Breath / 7Color が連続再生されます">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="#9E9E9E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContinuousMode}" Value="True">
                                            <Setter Property="Fill" Value="#FFC107"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ContinuousModeButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- Flash：ゴールドイエロー -->
                <Button x:Name="BtnFxFlash"
                        Grid.Column="2"
                        Command="{Binding ExecuteFlashCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsFlashRunning}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Fill="#FFD740"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FlashButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- FadeIn：マゼンタ -->
                <Button x:Name="BtnFxFadeIn"
                        Grid.Column="3"
                        Command="{Binding ExecuteFadeInCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsFadeInRunning}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Fill="#FF4FC3"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FadeInButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- FadeOut：ライム -->
                <Button x:Name="BtnFxFadeOut"
                        Grid.Column="4"
                        Command="{Binding ExecuteFadeOutCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsFadeOutRunning}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Fill="#A3FF12"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FadeOutButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- Breath：パープル -->
                <Button x:Name="BtnFxBreath"
                        Grid.Column="5"
                        Command="{Binding ExecuteBreathCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsBreathRunning}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Fill="#B388FF"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BreathButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>

                <!-- 7Color： シアン -->
                <Button x:Name="BtnFx7Color"
                        Grid.Column="6"
                        Command="{Binding ExecuteSevenColorCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSevenColorRunning}"
                        MinWidth="140"
                        MinHeight="48"
                        Margin="10,0,0,0"
                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0"
                                   Width="6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="3"
                                   RadiusY="3">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF0000" Offset="0.00"/>
                                    <GradientStop Color="#FF8000" Offset="0.16"/>
                                    <GradientStop Color="#FFFF00" Offset="0.33"/>
                                    <GradientStop Color="#00FF00" Offset="0.50"/>
                                    <GradientStop Color="#00FFFF" Offset="0.66"/>
                                    <GradientStop Color="#0000FF" Offset="0.83"/>
                                    <GradientStop Color="#FF00FF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SevenColorButtonText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- SequenceBar -->
        <Border Grid.Row="5"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="SEQUENCE"
                           Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnSeq01"
                        Grid.Column="1"
                        Content="Sequence01"
                        Command="{Binding ExecuteSequence01Command}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq02"
                        Grid.Column="2"
                        Content="Sequence02"
                        Command="{Binding ExecuteSequence02Command}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq03"
                        Grid.Column="3"
                        Content="Sequence03"
                        Command="{Binding ExecuteSequence03Command}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq04"
                        Grid.Column="4"
                        Content="Sequence04"
                        Command="{Binding ExecuteSequence04Command}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq05"
                        Grid.Column="5"
                        Content="Sequence05"
                        Command="{Binding ExecuteSequence05Command}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq06"
                        Grid.Column="6"
                        Content="Sequence06"
                        Command="{Binding ExecuteSequence06Command}"
                        IsEnabled="{Binding IsSequence06Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq07"
                        Grid.Column="7"
                        Content="Sequence07"
                        Command="{Binding ExecuteSequence07Command}"
                        IsEnabled="{Binding IsSequence07Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeqStop"
                        Grid.Column="8"
                        Content="Stop"
                        Command="{Binding StopSequenceCommand}"
                        IsEnabled="{Binding IsSequence01Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="20,0,20,20"
                Background="#3B0A0A"
                BorderBrush="#DC3545"
                BorderThickness="2"
                Padding="16,12"
                MaxWidth="520"
                MinWidth="260">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="ERROR"
                           Foreground="#FF6B6B"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource TextBrushMain}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="×"
                        Command="{Binding DismissErrorCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextBrushMain}"
                        FontSize="18"
                        FontWeight="Bold"
                        Width="28"
                        Height="28"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="6"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}"
                Padding="10,4">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        DataContext="{Binding Kpi}">
                <TextBlock Text="KPI"
                           FontWeight="Bold"
                           Foreground="#FFC107"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Queue -->
                <TextBlock Text="Queue:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding QueueText}"
                           Foreground="{Binding QueueBrush}"
                           FontWeight="Bold"
                           MinWidth="32"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Dropped -->
                <TextBlock Text="Dropped:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding DroppedText}"
                           Foreground="{Binding DroppedBrush}"
                           FontWeight="Bold"
                           MinWidth="32"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Reconnect -->
                <TextBlock Text="Reconnect:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding ReconnectText}"
                           Foreground="{Binding ReconnectBrush}"
                           FontWeight="Bold"
                           MinWidth="32"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Latency (P95) -->
                <TextBlock Text="Latency:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding LatencyText}"
                           Foreground="{Binding LatencyBrush}"
                           FontWeight="Bold"
                           MinWidth="96"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Success Rate -->
                <TextBlock Text="Success:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding SuccessRateText}"
                           Foreground="{Binding SuccessRateBrush}"
                           FontWeight="Bold"
                           MinWidth="72"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <!-- Total Sent -->
                <TextBlock Text="TotalSent:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding TotalSentText}"
                           Foreground="#EEE"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <!-- 操作ミス -->
                <TextBlock Text="MisOp:"
                           Foreground="#888"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{Binding MisOpText}"
                           Foreground="{Binding MisOpBrush}"
                           FontWeight="Bold"
                           MinWidth="32"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>