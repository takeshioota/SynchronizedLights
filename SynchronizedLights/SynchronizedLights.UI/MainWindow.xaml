<Window x:Class="SynchronizedLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrushMain}"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- TopBar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        Text="TOP"
                        Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnSpeed01"
                        Grid.Column="1"
                        Content="Speed01"
                        Command="{Binding ApplySpeed01Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed01Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed02"
                        Grid.Column="2"
                        Content="Speed02"
                        Command="{Binding ApplySpeed02Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed02Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed03"
                        Grid.Column="3"
                        Content="Speed03"
                        Command="{Binding ApplySpeed03Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed03Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSpeed04"
                        Grid.Column="4"
                        Content="Speed04"
                        Command="{Binding ApplySpeed04Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSpeed04Selected}"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="6"
                        Text="Target:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="7"
                        Text="{Binding CurrentTargetLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <TextBlock Grid.Column="9"
                        Text="Mode:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="10"
                        Text="{Binding CurrentCategory}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <TextBlock Grid.Column="12"
                        Text="Color:"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                <TextBlock Grid.Column="13"
                        Text="{Binding CurrentColorLabel}"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="8,0,0,0" />
                <Button x:Name="TglStrobeOff"
                        Grid.Column="15"
                        Content="StrobeOff"
                        Command="{Binding ToggleStrobeOffCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsStrobeOffActive}"
                        MinWidth="120"
                        MinHeight="44"
                        Margin="10,0,0,0" />
                <StackPanel Grid.Column="17"
                            Grid.ColumnSpan="2"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="{Binding PortAStatusLabel}"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding PortBStatusLabel}"
                               FontWeight="Bold"
                               FontSize="13" />
                </StackPanel>
                <TextBlock Grid.Column="19"
                        Text="{Binding StatusMessage}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Margin="20,0,10,0" />
            </Grid>
        </Border>

        <!-- MainPanelHost -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- CategoryMenu -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <StackPanel VerticalAlignment="Stretch">
                <TextBlock Text="CATEGORY"
                           Style="{StaticResource GrandMaSectionTitleStyle}"
                           Margin="0,0,0,10"/>
                <Button Content="Preset"
                        Command="{Binding ShowPresetCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsPresetSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="Mode"
                        Command="{Binding ShowModeCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsModeSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="Animation"
                        Command="{Binding ShowAnimationCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsAnimationSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
                <Button Content="Setting"
                        Command="{Binding ShowSettingCommand}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsSettingSelected}"
                        MinHeight="56"
                        Margin="0,0,0,10" />
            </StackPanel>
        </Border>

        <!-- TargetBar -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        Text="TARGET"
                        Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnTargetAll"
                        Grid.Column="1"
                        Content="ALL"
                        Command="{Binding SelectTargetAllCommand}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup01"
                        Grid.Column="2"
                        Content="Group01"
                        Command="{Binding SelectTargetGroup01Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup01Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup02"
                        Grid.Column="3"
                        Content="Group02"
                        Command="{Binding SelectTargetGroup02Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup02Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup03"
                        Grid.Column="4"
                        Content="Group03"
                        Command="{Binding SelectTargetGroup03Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup03Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup04"
                        Grid.Column="5"
                        Content="Group04"
                        Command="{Binding SelectTargetGroup04Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup04Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup05"
                        Grid.Column="6"
                        Content="Group05"
                        Command="{Binding SelectTargetGroup05Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup05Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnTargetGroup06"
                        Grid.Column="7"
                        Content="Group06"
                        Command="{Binding SelectTargetGroup06Command}"
                        Style="{StaticResource GrandMaSelectableButtonStyle}"
                        Tag="{Binding IsTargetGroup06Selected}"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- EffectBar -->
        <Border Grid.Row="3"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                            Text="EFFECT"
                            Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnFxFlash"
                        Grid.Column="1"
                        Content="Flash"
                        Command="{Binding ExecuteFlashCommand}"
                        IsEnabled="{Binding IsTransportConnected}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnFxFadeIn"
                        Grid.Column="2"
                        Content="FadeIn"
                        Command="{Binding ExecuteFadeInCommand}"
                        IsEnabled="{Binding IsTransportConnected}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnFxFadeOut"
                        Grid.Column="3"
                        Content="FadeOut"
                        Command="{Binding ExecuteFadeOutCommand}"
                        IsEnabled="{Binding IsTransportConnected}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- SequenceBar -->
        <Border Grid.Row="4"
                Grid.ColumnSpan="2"
                Style="{StaticResource GrandMaPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="SEQUENCE"
                           Style="{StaticResource GrandMaSectionTitleStyle}" />
                <Button x:Name="BtnSeq01"
                        Grid.Column="1"
                        Content="Sequence01"
                        Command="{Binding ExecuteSequence01Command}"
                        IsEnabled="{Binding IsSequence01Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq02"
                        Grid.Column="2"
                        Content="Sequence02"
                        Command="{Binding ExecuteSequence02Command}"
                        IsEnabled="{Binding IsSequence02Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq03"
                        Grid.Column="3"
                        Content="Sequence03"
                        Command="{Binding ExecuteSequence03Command}"
                        IsEnabled="{Binding IsSequence03Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq04"
                        Grid.Column="4"
                        Content="Sequence04"
                        Command="{Binding ExecuteSequence04Command}"
                        IsEnabled="{Binding IsSequence04Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq05"
                        Grid.Column="5"
                        Content="Sequence05"
                        Command="{Binding ExecuteSequence05Command}"
                        IsEnabled="{Binding IsSequence05Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq06"
                        Grid.Column="6"
                        Content="Sequence06"
                        Command="{Binding ExecuteSequence06Command}"
                        IsEnabled="{Binding IsSequence06Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeq07"
                        Grid.Column="7"
                        Content="Sequence07"
                        Command="{Binding ExecuteSequence07Command}"
                        IsEnabled="{Binding IsSequence07Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />
                <Button x:Name="BtnSeqStop"
                        Grid.Column="8"
                        Content="Stop"
                        Command="{Binding StopSequenceCommand}"
                        IsEnabled="{Binding IsSequence01Defined}"
                        Style="{StaticResource GrandMaButtonStyle}"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="20,0,20,20"
                Background="#3B0A0A"
                BorderBrush="#DC3545"
                BorderThickness="2"
                Padding="16,12"
                MaxWidth="520"
                MinWidth="260">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsErrorVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="ERROR"
                           Foreground="#FF6B6B"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource TextBrushMain}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="×"
                        Command="{Binding DismissErrorCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextBrushMain}"
                        FontSize="18"
                        FontWeight="Bold"
                        Width="28"
                        Height="28"
                        Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>