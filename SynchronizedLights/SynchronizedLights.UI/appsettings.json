{
  "Lighting": {
    "Mode": "Real",
    //"Mode": "Dummy",
    "ApiBaseUrl": "http://localhost:5100",
    "SendQueueCapacity": 256,
    "SendIntervalMs": 5,
    "DefaultChannel": 1,
    "DefaultPower": 3,

    "QueuePolicy": "Wait",
    "QueueDropThreshold": 0.95,

    "DummySendDelayMs": 100,

    "LatencyEnabled": true,
    "LatencyWindowSize": 1000,
    "LatencyLogIntervalSec": 30,

    "AutoReconnectEnabled": true,
    "ReconnectIntervalSec": 5,

    "HeartbeatEnabled": true,
    "HeartbeatIntervalSec": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  }
}
