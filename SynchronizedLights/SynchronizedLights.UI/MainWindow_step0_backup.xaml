<Window x:Class="SynchronizedLights.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowState="Maximized"
        ResizeMode="NoResize">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Menu -->

            <RowDefinition Height="*"/>
            <!-- Main Area -->

            <RowDefinition Height="120"/>
            <!-- Common -->

            <RowDefinition Height="100"/>
            <!-- Speed -->

            <RowDefinition Height="120"/>
            <!-- Sequence -->
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Preset"
                        Command="{Binding ShowPresetCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="0,0,10,0" />

                <Button Grid.Column="1"
                        Content="Mode"
                        Command="{Binding ShowModeCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="0,0,10,0" />

                <Button Grid.Column="2"
                        Content="Animation"
                        Command="{Binding ShowAnimationCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="0,0,10,0" />

                <Button Grid.Column="3"
                        Content="Sequence"
                        Command="{Binding ShowSequenceCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="0,0,10,0" />

                <Button Grid.Column="4"
                        Content="Setting"
                        Command="{Binding ShowSettingCommand}"
                        MinWidth="120"
                        MinHeight="48"
                        Margin="0,0,10,0" />

                <TextBlock Grid.Column="5"
                        Text="{Binding CurrentCategory}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold" />
            </Grid>
        </Border>

        <!-- Main Area -->
        <Border Grid.Row="1"
            BorderBrush="Gray"
            BorderThickness="1">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>

        <!-- Common -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="COMMON"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold" />

                <Button Grid.Column="1"
                        Content="ALL"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="2"
                        Content="Group"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="3"
                        Content="Flash"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="4"
                        Content="Fade"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="5"
                        Content="On"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="6"
                        Content="Off"
                        MinWidth="100"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- Speed -->
        <Border Grid.Row="3"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="SPEED"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold" />

                <Button Grid.Column="1"
                        Content="Speed01"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button Grid.Column="2"
                        Content="Speed02"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button Grid.Column="3"
                        Content="Speed03"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />

                <Button Grid.Column="4"
                        Content="Edit"
                        MinWidth="110"
                        MinHeight="44"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- Sequence -->
        <Border Grid.Row="4"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="SEQUENCE"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold" />

                <Button Grid.Column="1"
                        Content="Sequence01"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="2"
                        Content="Sequence02"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="3"
                        Content="Sequence03"
                        MinWidth="130"
                        MinHeight="48"
                        Margin="10,0,0,0" />

                <Button Grid.Column="4"
                        Content="Stop"
                        MinWidth="110"
                        MinHeight="48"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>